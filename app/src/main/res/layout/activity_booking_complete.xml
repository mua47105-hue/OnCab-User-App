<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/collectCash"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="32dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginTop="20dp"
                android:src="@drawable/verify"/>
            <TextView
                android:textSize="22sp"
                android:textColor="@color/black"
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Reached Destination!"
                android:fontFamily="@font/roboto_bold"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/grey"
                android:gravity="center"
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="32dp"
                android:layout_marginTop="4dp"
                android:layout_marginRight="32dp"
                android:text="Hope you had a safe and pleasant ride with OnCab"
                android:fontFamily="@font/roboto"
                android:layout_marginHorizontal="32dp"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/tvPersonalizedMsg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="12dp"
                android:layout_marginRight="24dp"
                android:text="Thank You For Choosing OnCab"
                android:fontFamily="@font/roboto_bold"
                android:layout_marginHorizontal="24dp"/>
            <TextView
                android:textSize="28sp"
                android:textColor="@color/black"
                android:id="@+id/payableAmount2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 rs"
                android:fontFamily="@font/roboto_bold"/>
            <TextView
                android:textSize="10sp"
                android:textColor="#33a1c9"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="PICKUP"
                android:fontFamily="@font/roboto_bold"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/grey"
                android:gravity="center"
                android:id="@+id/tvPickupDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="40dp"
                android:layout_marginTop="2dp"
                android:layout_marginRight="40dp"
                android:text="N/A"
                android:fontFamily="@font/roboto"
                android:layout_marginHorizontal="40dp"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/grey"
                android:id="@+id/tvStoppageLabel"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="STOP"
                android:fontFamily="@font/roboto_bold"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/grey"
                android:gravity="center"
                android:id="@+id/tvStoppageDisplay"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="40dp"
                android:layout_marginTop="2dp"
                android:layout_marginRight="40dp"
                android:text="N/A"
                android:fontFamily="@font/roboto"
                android:layout_marginHorizontal="40dp"/>
            <TextView
                android:textSize="10sp"
                android:textColor="#e57373"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="DESTINATION"
                android:fontFamily="@font/roboto_bold"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/grey"
                android:gravity="center"
                android:id="@+id/tvDestinationDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="40dp"
                android:layout_marginTop="2dp"
                android:layout_marginRight="40dp"
                android:text="N/A"
                android:fontFamily="@font/roboto"
                android:layout_marginHorizontal="40dp"/>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFare"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="24dp"
                android:layout_marginHorizontal="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="#eeeeee"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="18sp"
                        android:textColor="@color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fare Summary"
                        android:fontFamily="@font/roboto_bold"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/grey"
                        android:id="@+id/tvOrderIdDisplay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Booking ID: #0"
                        android:fontFamily="@font/roboto"/>
                    <View
                        android:background="#eeeeee"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:layout_marginVertical="16dp"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/llFareDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp">
                            <TextView
                                android:textSize="15sp"
                                android:textColor="@color/grey"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="Original Fare"
                                android:layout_weight="1"
                                android:fontFamily="@font/roboto"/>
                            <TextView
                                android:textSize="15sp"
                                android:textColor="@color/black"
                                android:id="@+id/tvCompleteTotalFare"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₹0"
                                android:fontFamily="@font/roboto_bold"/>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/offerDiscountSection"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp">
                            <TextView
                                android:textSize="15sp"
                                android:textColor="@color/grey"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="Offer Discount"
                                android:layout_weight="1"
                                android:fontFamily="@font/roboto"/>
                            <TextView
                                android:textSize="15sp"
                                android:textColor="#4caf50"
                                android:id="@+id/tvCompleteOfferDiscount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-₹0"
                                android:fontFamily="@font/roboto_bold"/>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/walletBreakdownSection"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp">
                            <TextView
                                android:textSize="15sp"
                                android:textColor="@color/grey"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="User Wallet Used"
                                android:layout_weight="1"
                                android:fontFamily="@font/roboto"/>
                            <TextView
                                android:textSize="15sp"
                                android:textColor="#4caf50"
                                android:id="@+id/tvCompleteWalletPaid"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-₹0"
                                android:fontFamily="@font/roboto_bold"/>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/totalPaidSection"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp">
                            <TextView
                                android:textSize="15sp"
                                android:textColor="@color/grey"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="Total User Paid"
                                android:layout_weight="1"
                                android:fontFamily="@font/roboto"/>
                            <TextView
                                android:textSize="15sp"
                                android:textColor="@color/black"
                                android:id="@+id/tvTotalUserPaid"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₹0"
                                android:fontFamily="@font/roboto_bold"/>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/driverWalletSection"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="5dp">
                            <TextView
                                android:textSize="15sp"
                                android:textColor="@color/grey"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="Driver Wallet Credit"
                                android:layout_weight="1"
                                android:fontFamily="@font/roboto"/>
                            <TextView
                                android:textSize="15sp"
                                android:textColor="#4caf50"
                                android:id="@+id/tvDriverWalletCredit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+₹0"
                                android:fontFamily="@font/roboto_bold"/>
                        </LinearLayout>
                        <View
                            android:background="#eeeeee"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="5dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/black"
                            android:id="@+id/tvPayableLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Cash to Pay"
                            android:layout_weight="1"
                            android:fontFamily="@font/roboto_bold"/>
                        <TextView
                            android:textSize="28sp"
                            android:textColor="@color/black"
                            android:id="@+id/payableAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹0"
                            android:fontFamily="@font/roboto_bold"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/grey"
                        android:id="@+id/tvPaymentMethod"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Payment Method: CASH"
                        android:fontFamily="@font/roboto"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="16sp"
        android:textColor="@color/white"
        android:id="@+id/collectCash"
        android:background="#000000"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="24dp"
        android:text="DONE"
        android:textAllCaps="true"
        android:fontFamily="@font/roboto_bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
