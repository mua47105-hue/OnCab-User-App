<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/colorBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout8"
        android:background="?attr/colorSurface"
        android:paddingLeft="16dp"
        android:paddingTop="10dp"
        android:paddingRight="16dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="4dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/backBtn"
            android:padding="6dp"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/colorOnSurface"/>
        <TextView
            android:textSize="18sp"
            android:textColor="?attr/colorOnSurface"
            android:id="@+id/tvStaticHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Need help with your ride?"
            android:fontFamily="@font/roboto_bold"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/backBtn"
            app:layout_constraintEnd_toStartOf="@+id/ivSupportIcon"
            app:layout_constraintStart_toEndOf="@+id/backBtn"
            app:layout_constraintTop_toTopOf="@+id/backBtn"/>
        <ImageView
            android:id="@+id/ivSupportIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/support_service"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/colorOnSurface"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/constraintLayout8">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ccAfterRide"
                android:paddingLeft="16dp"
                android:paddingTop="16dp"
                android:paddingRight="16dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp">
                <TextView
                    android:textSize="15sp"
                    android:textColor="?attr/colorOnSurface"
                    android:id="@+id/tvLastRideLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Last ride"
                    android:fontFamily="@font/roboto_bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/materialCardView5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="2dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="2dp"
                    android:layout_marginBottom="12dp"
                    android:layout_marginHorizontal="2dp"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardUseCompatPadding="true"
                    app:layout_constraintTop_toBottomOf="@+id/tvLastRideLabel">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/thisRides"
                            android:padding="16dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:layout_constraintTop_toTopOf="parent">
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cvCarIcon"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                                app:cardCornerRadius="10dp"
                                app:cardElevation="0dp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent">
                                <ImageView
                                    android:id="@+id/ivCar"
                                    android:padding="8dp"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:src="@drawable/ic_car_type"
                                    app:tint="?attr/colorOnSurface"/>
                            </com.google.android.material.card.MaterialCardView>
                            <TextView
                                android:textSize="13sp"
                                android:textColor="#3fa543"
                                android:id="@+id/rideStatus"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="Completed"
                                android:fontFamily="@font/roboto_bold"
                                android:layout_marginStart="16dp"
                                android:layout_marginEnd="8dp"
                                app:layout_constraintBaseline_toBaselineOf="@+id/tvHeader"
                                app:layout_constraintEnd_toStartOf="@+id/tvHeader"
                                app:layout_constraintStart_toEndOf="@+id/cvCarIcon"/>
                            <TextView
                                android:textSize="11sp"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:id="@+id/tvHeader"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="11:59 AM, 20 Jul"
                                android:fontFamily="@font/roboto"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <TextView
                                android:textSize="16sp"
                                android:textColor="?attr/colorOnSurface"
                                android:id="@+id/tripPrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₹0"
                                android:fontFamily="@font/roboto_bold"
                                app:layout_constraintBottom_toBottomOf="@+id/ivDropDot"
                                app:layout_constraintEnd_toEndOf="@+id/cvCarIcon"
                                app:layout_constraintStart_toStartOf="@+id/cvCarIcon"
                                app:layout_constraintTop_toTopOf="@+id/ivDropDot"/>
                            <ImageView
                                android:id="@+id/ivPickupDot"
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:src="@drawable/circle"
                                android:layout_marginStart="16dp"
                                app:layout_constraintBottom_toBottomOf="@+id/tvSource"
                                app:layout_constraintStart_toEndOf="@+id/cvCarIcon"
                                app:layout_constraintTop_toTopOf="@+id/tvSource"
                                app:tint="@color/green"/>
                            <TextView
                                android:textSize="13sp"
                                android:textColor="?attr/colorOnSurface"
                                android:ellipsize="end"
                                android:id="@+id/tvSource"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="Source Location"
                                android:maxLines="2"
                                android:fontFamily="@font/roboto"
                                android:layout_marginStart="10dp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/ivPickupDot"
                                app:layout_constraintTop_toBottomOf="@+id/rideStatus"/>
                            <ImageView
                                android:id="@+id/ivDropDot"
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:src="@drawable/circle"
                                app:layout_constraintBottom_toBottomOf="@+id/tvDestination"
                                app:layout_constraintStart_toStartOf="@+id/ivPickupDot"
                                app:layout_constraintTop_toTopOf="@+id/tvDestination"
                                app:tint="@color/red"/>
                            <TextView
                                android:textSize="13sp"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:ellipsize="end"
                                android:id="@+id/tvDestination"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="Destination Location"
                                android:maxLines="2"
                                android:fontFamily="@font/roboto"
                                android:layout_marginStart="10dp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/ivDropDot"
                                app:layout_constraintTop_toBottomOf="@+id/tvSource"/>
                            <TextView
                                android:id="@+id/description"
                                android:visibility="gone"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <View
                            android:id="@+id/view10"
                            android:background="?attr/colorSurfaceVariant"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            app:layout_constraintTop_toBottomOf="@+id/thisRides"/>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/otherRides"
                            android:paddingLeft="16dp"
                            android:paddingTop="12dp"
                            android:paddingRight="16dp"
                            android:paddingBottom="12dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="12dp"
                            app:layout_constraintTop_toBottomOf="@+id/view10">
                            <TextView
                                android:textSize="15sp"
                                android:textColor="?attr/colorOnSurface"
                                android:id="@+id/textView29"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Other rides"
                                android:fontFamily="@font/roboto"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/next"
                                app:layout_constraintBottom_toBottomOf="@+id/textView29"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="@+id/textView29"
                                app:tint="?attr/colorOnSurface"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ProgressBar
                    android:id="@+id/rideProgressBar"
                    android:visibility="visible"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="40dp"
                    android:layout_marginBottom="40dp"
                    android:indeterminateTint="?attr/colorPrimary"
                    android:layout_marginVertical="40dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ccBeforeRide"
                android:paddingLeft="16dp"
                android:paddingTop="12dp"
                android:paddingRight="16dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:id="@+id/textViewSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Let us help you get started"
                    android:fontFamily="@font/roboto_light"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="?attr/colorSurfaceVariant"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:layout_constraintTop_toBottomOf="@+id/textViewSub">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:padding="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <TextView
                            android:textSize="16sp"
                            android:textColor="?attr/colorOnSurface"
                            android:id="@+id/textView26"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Join OnCab today and book your first journey!"
                            android:fontFamily="@font/roboto_medium"
                            android:layout_marginEnd="16dp"
                            app:layout_constraintEnd_toStartOf="@+id/imageView32"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/new_gray"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Get to know how to book your preferred in just three steps"
                            android:fontFamily="@font/roboto"
                            android:layout_marginEnd="16dp"
                            app:layout_constraintEnd_toStartOf="@+id/imageView32"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/textView26"/>
                        <ImageView
                            android:id="@+id/imageView32"
                            android:layout_width="22dp"
                            android:layout_height="18dp"
                            android:src="@drawable/next"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="?attr/colorOnSurface"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:paddingHorizontal="16dp">
                <TextView
                    android:textSize="18sp"
                    android:textColor="?attr/colorOnSurface"
                    android:id="@+id/textView27"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Other help topics"
                    android:fontFamily="@font/roboto_medium"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:id="@+id/searchIcon"
                    android:background="@drawable/circle1"
                    android:padding="10dp"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@drawable/ic_baseline_search_24"
                    android:backgroundTint="#f2f2f2"
                    app:layout_constraintBottom_toBottomOf="@+id/textView27"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/textView27"
                    app:tint="@color/black"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/helpRecyclerView"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="16dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
