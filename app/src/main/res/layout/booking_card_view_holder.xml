<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeColor="#eeeeee"
    app:strokeWidth="1dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvCarIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardBackgroundColor="#f8f8f8"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/ivCar"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/auto_marker"
                app:tint="@color/black"/>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            app:cardBackgroundColor="#e8f5e9"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:layout_constraintStart_toEndOf="@+id/cvCarIcon"
            app:layout_constraintTop_toTopOf="@+id/cvCarIcon">
            <TextView
                android:textSize="12sp"
                android:textColor="#2e7d32"
                android:id="@+id/tvStatus"
                android:paddingLeft="10dp"
                android:paddingTop="4dp"
                android:paddingRight="10dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Completed"
                android:fontFamily="@font/roboto_bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"/>
        </com.google.android.material.card.MaterialCardView>
        <TextView
            android:textSize="12sp"
            android:textColor="#999999"
            android:id="@+id/carType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Daily"
            android:fontFamily="@font/roboto_medium"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/cvStatusBadge"
            app:layout_constraintStart_toEndOf="@+id/cvStatusBadge"
            app:layout_constraintTop_toTopOf="@+id/cvStatusBadge"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/black"
            android:id="@+id/tripPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹50"
            android:fontFamily="@font/roboto_bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/cvStatusBadge"/>
        <TextView
            android:textSize="11sp"
            android:textColor="#999999"
            android:id="@+id/tripDateTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="02:16 PM · 26 Aug 2026"
            android:fontFamily="@font/roboto"
            app:layout_constraintStart_toStartOf="@+id/cvStatusBadge"
            app:layout_constraintTop_toBottomOf="@+id/cvStatusBadge"/>
        <View
            android:id="@+id/vLine"
            android:background="#eeeeee"
            android:layout_width="1.5dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/ivDropDot"
            app:layout_constraintEnd_toEndOf="@+id/ivPickupDot"
            app:layout_constraintStart_toStartOf="@+id/ivPickupDot"
            app:layout_constraintTop_toTopOf="@+id/ivPickupDot"/>
        <ImageView
            android:id="@+id/ivPickupDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginTop="24dp"
            android:src="@drawable/circle"
            app:layout_constraintStart_toStartOf="@+id/cvCarIcon"
            app:layout_constraintTop_toBottomOf="@+id/tripDateTime"
            app:tint="#2e7d32"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/black"
            android:ellipsize="end"
            android:id="@+id/sourceAddress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="3618A, Mauza Dhelua, Panchpot..."
            android:maxLines="1"
            android:fontFamily="@font/roboto_medium"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/ivPickupDot"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivPickupDot"
            app:layout_constraintTop_toTopOf="@+id/ivPickupDot"/>
        <ImageView
            android:id="@+id/ivDropDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginTop="20dp"
            android:src="@drawable/circle"
            app:layout_constraintStart_toStartOf="@+id/ivPickupDot"
            app:layout_constraintTop_toBottomOf="@+id/sourceAddress"
            app:tint="#d32f2f"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/black"
            android:ellipsize="end"
            android:id="@+id/destinationAddress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Shahid Khudiram, Garia Station ..."
            android:maxLines="1"
            android:fontFamily="@font/roboto_medium"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/ivDropDot"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivDropDot"
            app:layout_constraintTop_toTopOf="@+id/ivDropDot"/>
        <TextView
            android:id="@+id/tripId"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
