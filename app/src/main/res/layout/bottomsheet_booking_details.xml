<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomSheet"
    android:background="?attr/colorSurface"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:behavior_hideable="false"
    app:behavior_peekHeight="380dp"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <LinearLayout
        android:orientation="vertical"
        android:paddingBottom="30dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:layout_gravity="center"
            android:background="@drawable/bg_grabber"
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="4dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/llTop"
            android:paddingLeft="20dp"
            android:paddingTop="14dp"
            android:paddingRight="20dp"
            android:paddingBottom="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingVertical="14dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:background="@drawable/bg_status_badge"
                    android:layout_width="26dp"
                    android:layout_height="26dp">
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/ivStatusIcon"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        app:srcCompat="@drawable/verify"
                        app:tint="#ffffff"/>
                </FrameLayout>
                <TextView
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:id="@+id/tvRideStatusHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your ride is confirmed."
                    android:layout_marginStart="10dp"
                    android:letterSpacing="-0.01"/>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:id="@+id/tvBookingId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="monospace"
                android:layout_marginStart="36dp"
                android:letterSpacing="0.02"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/llOtp"
            android:paddingLeft="16dp"
            android:paddingTop="5dp"
            android:paddingRight="16dp"
            android:paddingBottom="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="5dp"
            android:layout_marginHorizontal="20dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="5dp">
            <TextView
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:id="@+id/tvStartOtpLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ride_confirmation_otp"/>
            <TextView
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:id="@+id/tvOtp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:layout_marginStart="8dp"
                android:letterSpacing="0.15"/>
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>
            <TextView
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:id="@+id/endOtp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ride End OTP: "/>
            <TextView
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:id="@+id/tvEndOtp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:layout_marginStart="5dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/llDriverDetails"
            android:background="@drawable/bg_surface_mute_card"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="10dp"
            android:layout_marginHorizontal="20dp">
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/ivDriverImage"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/profile"
                app:civ_border_color="#ffffff"
                app:civ_border_width="2dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:id="@+id/tvDriverName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:src="@drawable/ic_star"
                        android:layout_marginStart="8dp"
                        app:tint="#d9971f"/>
                    <TextView
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:id="@+id/tvDriverReview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5.0"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>
                <TextView
                    android:textSize="13sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:id="@+id/tvCarName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:id="@+id/tvCarNo"
                    android:background="@drawable/bg_plate_chip"
                    android:paddingLeft="8dp"
                    android:paddingTop="2dp"
                    android:paddingRight="8dp"
                    android:paddingBottom="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/ivCarImage"
                android:layout_width="72dp"
                android:layout_height="52dp"
                android:src="@drawable/auto_marker"
                android:scaleType="centerInside"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/llCallDriver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="12dp"
            android:layout_marginHorizontal="20dp">
            <LinearLayout
                android:gravity="center"
                android:id="@+id/layCall"
                android:background="@drawable/bg_icon_btn_dark"
                android:layout_width="48dp"
                android:layout_height="48dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_baseline_call_24"
                    app:tint="#ffffff"/>
            </LinearLayout>
            <TextView
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurface"
                android:gravity="center_vertical"
                android:id="@+id/tvMessage"
                android:background="@drawable/bg_pill_outline"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/message_your_driver"
                android:drawablePadding="8dp"
                android:layout_marginStart="10dp"
                android:paddingHorizontal="16dp"
                app:drawableEndCompat="@drawable/ic_baseline_send_24"
                app:drawableTint="?attr/colorOnSurfaceVariant"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#0e5c4e"
                android:gravity="center"
                android:id="@+id/tvSafeRideMsg"
                android:background="@drawable/bg_safe_ride_chip"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Have a safe ride with OnCab"
                android:drawablePadding="8dp"
                android:fontFamily="@font/roboto_medium"
                android:layout_marginStart="10dp"
                app:drawableStartCompat="@drawable/ic_shield_check"
                app:drawableTint="#0e7c55"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/llPlace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="20dp"
            android:layout_marginHorizontal="20dp">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginTop="3dp"
                    android:src="@drawable/circle1"
                    app:tint="@color/green"/>
                <ImageView
                    android:id="@+id/ivRouteLine1"
                    android:background="#e4e4e4"
                    android:layout_width="2dp"
                    android:layout_height="36dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:layout_marginVertical="4dp"/>
                <ImageView
                    android:id="@+id/ivStoppageCircle"
                    android:visibility="gone"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:src="@drawable/circle1"
                    app:tint="@color/grey"/>
                <ImageView
                    android:id="@+id/ivRouteLine2"
                    android:background="#e4e4e4"
                    android:visibility="gone"
                    android:layout_width="2dp"
                    android:layout_height="36dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:layout_marginVertical="4dp"/>
                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/circle1"
                    app:tint="@color/red"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp">
                <TextView
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:id="@+id/tvSource"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/source"
                    android:lineSpacingExtra="2dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/llStoppage"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp">
                    <TextView
                        android:textSize="13sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:id="@+id/tvStoppage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <TextView
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:id="@+id/tvDestination"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:text="@string/destination"
                    android:lineSpacingExtra="2dp"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/green"
            android:id="@+id/tvDestInfo"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="44dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/llFunc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="18dp"
            android:layout_marginRight="20dp"
            android:layout_marginHorizontal="20dp">
            <View
                android:background="#ededed"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="52dp">
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:gravity="center"
                    android:id="@+id/tvCancel"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/cancel"
                    android:drawablePadding="6dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="8dp"
                    app:drawableTopCompat="@drawable/ic_baseline_close_24"/>
                <View
                    android:id="@+id/vDividerCancel"
                    android:background="#ededed"
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:layout_marginVertical="14dp"/>
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:gravity="center"
                    android:id="@+id/tvSupport"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/support"
                    android:drawablePadding="6dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="8dp"
                    app:drawableTopCompat="@drawable/ic_baseline_question_mark_24"/>
                <View
                    android:background="#ededed"
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:layout_marginVertical="14dp"/>
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:gravity="center"
                    android:id="@+id/tvShare"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/share"
                    android:drawablePadding="6dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="8dp"
                    app:drawableTopCompat="@drawable/ic_baseline_share_24"/>
            </LinearLayout>
            <View
                android:background="#ededed"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/llFare"
            android:background="@drawable/bg_surface_mute_card"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="18dp"
            android:layout_marginRight="20dp"
            android:layout_marginHorizontal="20dp">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/total_fare"/>
                <TextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:gravity="end"
                    android:id="@+id/tvFare"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/llWalletDeduction"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/green"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wallet Used:"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/green"
                    android:gravity="end"
                    android:id="@+id/tvWalletAmount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>
            <View
                android:background="#e6e6e1"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:layout_marginVertical="12dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="13.5sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:id="@+id/tvPMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/payment_mode"/>
                <TextView
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:gravity="end"
                    android:id="@+id/tvPaymentMode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"/>
                <TextView
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/blue"
                    android:id="@+id/tvChangePayment"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/change"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="20dp"
            android:layout_marginHorizontal="20dp">
            <TextView
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:textColor="@color/orange"
                android:id="@+id/rideetaisl_tvRideDetails"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Parking And Toll Tax are extra and will be paid by you directly to the driver."
                android:layout_weight="1"
                android:fontFamily="@font/roboto_bold"/>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
