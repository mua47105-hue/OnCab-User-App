<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_background"
    android:paddingLeft="24dp"
    android:paddingTop="12dp"
    android:paddingRight="24dp"
    android:paddingBottom="36dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="24dp">
    <View
        android:layout_gravity="center_horizontal"
        android:background="#e0e0e0"
        android:layout_width="45dp"
        android:layout_height="4dp"
        android:layout_marginBottom="24dp"/>
    <TextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/textView77"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Why are you cancelling?"
        android:fontFamily="@font/roboto_bold"/>
    <ScrollView
        android:id="@+id/svReasons"
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="24dp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/llReasonsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/black"
                android:id="@+id/tvReason1"
                android:background="@drawable/border_background_01"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="Driver is too far away"
                android:backgroundTint="#f5f5f5"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/black"
                android:id="@+id/tvReason2"
                android:background="@drawable/border_background_01"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="Wait time is too long"
                android:backgroundTint="#f5f5f5"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/black"
                android:id="@+id/tvReason3"
                android:background="@drawable/border_background_01"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="The price is not reasonable"
                android:backgroundTint="#f5f5f5"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/black"
                android:id="@+id/tvReason4"
                android:background="@drawable/border_background_01"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="Wrong address shown"
                android:backgroundTint="#f5f5f5"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/black"
                android:id="@+id/tvReason5"
                android:background="@drawable/border_background_01"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="Driver asked to cancel"
                android:backgroundTint="#f5f5f5"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/black"
                android:id="@+id/tvReason6"
                android:background="@drawable/border_background_01"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="Other"
                android:backgroundTint="#f5f5f5"/>
            <EditText
                android:textSize="14sp"
                android:id="@+id/etOtherReason"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="Type your reason here..."/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="15sp"
            android:textColor="@color/white"
            android:id="@+id/cancelRide"
            android:background="@drawable/button_background01"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="Cancel Ride"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:fontFamily="@font/roboto_bold"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/red1"/>
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="15sp"
            android:textColor="@color/white"
            android:id="@+id/returnToRide"
            android:background="@drawable/button_background01"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="Go Back"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:fontFamily="@font/roboto_bold"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/black"/>
    </LinearLayout>
</LinearLayout>
