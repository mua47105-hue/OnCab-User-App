<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="12dp"
    android:layout_marginTop="20dp"
    android:layout_marginRight="12dp"
    android:layout_marginBottom="20dp"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="20dp"
    app:cardBackgroundColor="#84070707"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"
    app:strokeColor="#22c55e"
    app:strokeWidth="1dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="#9e000000"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp">
        <ProgressBar
            android:id="@+id/timerProgress"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:progressDrawable="@drawable/custom_timer_progress"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingLeft="16dp"
            android:paddingTop="7dp"
            android:paddingRight="16dp"
            android:paddingBottom="9dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@+id/timerProgress">
            <TextView
                android:id="@+id/tvTimer"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/ivDriverImg"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/avatar_1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/llDriverInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                app:layout_constraintEnd_toStartOf="@+id/ridePrice"
                app:layout_constraintStart_toEndOf="@+id/ivDriverImg"
                app:layout_constraintTop_toTopOf="@+id/ivDriverImg">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:id="@+id/driverName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Driver Name"
                    android:fontFamily="@font/roboto_bold"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:src="@drawable/ic_star"
                        app:tint="#ffc107"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#ffc107"
                        android:id="@+id/rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4.8"
                        android:fontFamily="@font/roboto_bold"
                        android:layout_marginStart="4dp"/>
                    <TextView
                        android:textSize="11sp"
                        android:textColor="#888888"
                        android:id="@+id/tvTripsCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="(500+ trips)"
                        android:fontFamily="@font/roboto"
                        android:layout_marginStart="6dp"/>
                </LinearLayout>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#aaaaaa"
                    android:id="@+id/carType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Car Model • 1.0 km"
                    android:fontFamily="@font/roboto"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#4caf50"
                    android:id="@+id/estDriverTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 min"
                    android:fontFamily="@font/roboto_bold"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/llOfferBreakdown"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp">
                    <TextView
                        android:textSize="11sp"
                        android:textColor="#aaaaaa"
                        android:id="@+id/tvOriginalPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹450"
                        android:fontFamily="@font/roboto"/>
                    <TextView
                        android:textSize="11sp"
                        android:textColor="#22c55e"
                        android:id="@+id/tvDiscountAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-₹200 OFF"
                        android:fontFamily="@font/roboto_medium"
                        android:layout_marginStart="6dp"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:textSize="26sp"
                android:textColor="@color/white"
                android:id="@+id/ridePrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0"
                android:fontFamily="@font/roboto_bold"
                app:layout_constraintBottom_toBottomOf="@+id/ivDriverImg"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/ivDriverImg"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="12dp"
                android:weightSum="2"
                app:layout_constraintTop_toBottomOf="@+id/llDriverInfo">
                <androidx.appcompat.widget.AppCompatButton
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:id="@+id/decline"
                    android:background="@drawable/button_background01"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="Decline"
                    android:layout_weight="0.8"
                    android:textAllCaps="false"
                    android:fontFamily="@font/roboto_bold"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="@color/red1"/>
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.2"
                    android:layout_marginStart="6dp">
                    <androidx.appcompat.widget.AppCompatButton
                        android:textSize="15sp"
                        android:textColor="@color/white"
                        android:id="@+id/accept"
                        android:background="@drawable/button_background01"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="Accept Offer"
                        android:textAllCaps="false"
                        android:fontFamily="@font/roboto_bold"
                        android:backgroundTint="#22c55e"/>
                    <ProgressBar
                        android:layout_gravity="center"
                        android:id="@+id/acceptLoader"
                        android:visibility="gone"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:indeterminateTint="@color/black"/>
                </FrameLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
