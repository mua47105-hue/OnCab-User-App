<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="15dp"
    android:layout_marginEnd="15dp"
    app:cardCornerRadius="40dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/view7"
            android:background="@color/grey"
            android:layout_width="60dp"
            android:layout_height="2dp"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/grey"
            android:gravity="center"
            android:id="@+id/textView76"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Amount adjustable, you can pick your amount from below options"
            android:fontFamily="@font/roboto"
            android:paddingHorizontal="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view7"/>
        <View
            android:id="@+id/view8"
            android:background="@color/black_text_01"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/textView76"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/priceControls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view8">
            <TextView
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tvMinus"
                android:background="@drawable/button_background01"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:text="-"
                android:backgroundTint="@color/black_text_01"/>
            <EditText
                android:textSize="32sp"
                android:textColor="@color/white"
                android:textColorHint="@color/grey"
                android:gravity="center"
                android:id="@+id/finalPayment"
                android:background="@android:color/transparent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:minWidth="120dp"
                android:hint="₹0"
                android:digits="₹0123456789"
                android:inputType="number"
                android:fontFamily="@font/roboto"
                android:layout_marginHorizontal="20dp"/>
            <TextView
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tvPlus"
                android:background="@drawable/button_background01"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:text="+"
                android:backgroundTint="@color/black_text_01"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/linearLayout21"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:weightSum="4"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/priceControls">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/firstPrice"
                android:background="@drawable/button_background01"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="₹100"
                android:layout_weight="1"
                android:fontFamily="@font/roboto_medium"
                android:backgroundTint="@color/black_text_01"
                android:paddingVertical="8dp"/>
            <View
                android:layout_width="8dp"
                android:layout_height="1dp"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/secondPrice"
                android:background="@drawable/button_background01"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="₹110"
                android:layout_weight="1"
                android:fontFamily="@font/roboto_medium"
                android:backgroundTint="@color/black_text_01"
                android:paddingVertical="8dp"/>
            <View
                android:layout_width="8dp"
                android:layout_height="1dp"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/thirdPrice"
                android:background="@drawable/button_background01"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="₹120"
                android:layout_weight="1"
                android:fontFamily="@font/roboto_medium"
                android:backgroundTint="@color/black_text_01"
                android:paddingVertical="8dp"/>
            <View
                android:layout_width="8dp"
                android:layout_height="1dp"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/fourthPrice"
                android:background="@drawable/button_background01"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="₹130"
                android:layout_weight="1"
                android:fontFamily="@font/roboto_medium"
                android:backgroundTint="@color/black_text_01"
                android:paddingVertical="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="32dp"
            android:weightSum="2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/linearLayout21">
            <TextView
                android:textSize="18sp"
                android:textColor="@color/red1"
                android:gravity="center"
                android:id="@+id/cancel"
                android:background="@color/categoryBackgroundBlack"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Cancel"
                android:layout_weight="1"
                android:fontFamily="@font/roboto_medium"/>
            <TextView
                android:textSize="18sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/done"
                android:background="@color/black_text_01"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Done"
                android:layout_weight="1"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
