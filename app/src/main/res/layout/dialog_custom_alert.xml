<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="22dp"
    app:cardElevation="10dp"
    app:strokeWidth="0dp">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingTop="24dp"
        android:paddingRight="24dp"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp">
        <FrameLayout
            android:background="@drawable/rounded_border_background"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:backgroundTint="#e0f2ec">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/ivAlertIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/busiconone"/>
        </FrameLayout>
        <TextView
            android:textSize="18sp"
            android:textColor="#111827"
            android:gravity="center"
            android:id="@+id/tvAlertTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Notice"
            android:fontFamily="@font/roboto_bold"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#4b5563"
            android:gravity="center"
            android:id="@+id/tvAlertMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Alert message content goes here."
            android:lineSpacingExtra="3dp"
            android:fontFamily="@font/roboto"/>
        <com.google.android.material.button.MaterialButton
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:id="@+id/btnAlertOk"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="22dp"
            android:text="OK"
            android:textAllCaps="false"
            android:fontFamily="@font/roboto_bold"
            app:backgroundTint="#0e6047"
            app:cornerRadius="14dp"
            app:elevation="0dp"
            app:strokeWidth="0dp"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
