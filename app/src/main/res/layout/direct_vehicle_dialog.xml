<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="?attr/colorSurface"
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="20sp"
            android:textColor="?attr/colorOnSurface"
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Direct Booking"
            android:fontFamily="@font/roboto_bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:id="@+id/tvMsg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Enter vehicle number to find your driver"
            android:fontFamily="@font/roboto"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle"/>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilVehicleNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="Vehicle Number (e.g. WB01A1234)"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:layout_constraintTop_toBottomOf="@+id/tvMsg"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText
                android:textColor="?attr/colorOnSurface"
                android:id="@+id/etVehicleNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:maxLength="10"
                android:inputType="textCapCharacters"/>
        </com.google.android.material.textfield.TextInputLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/driverFoundSection"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@+id/tilVehicleNumber">
            <View
                android:id="@+id/divider"
                android:background="?attr/colorSurfaceVariant"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                app:layout_constraintTop_toTopOf="parent"/>
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/ivDriverPhoto"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginTop="16dp"
                android:src="@drawable/avatar_1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divider"/>
            <TextView
                android:textSize="18sp"
                android:textColor="?attr/colorOnSurface"
                android:id="@+id/tvDriverName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Driver Name"
                android:fontFamily="@font/roboto_bold"
                android:layout_marginStart="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ivDriverPhoto"
                app:layout_constraintTop_toTopOf="@+id/ivDriverPhoto"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#34a853"
                android:id="@+id/tvDriverStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Available for booking"
                android:fontFamily="@font/roboto"
                app:layout_constraintStart_toStartOf="@+id/tvDriverName"
                app:layout_constraintTop_toBottomOf="@+id/tvDriverName"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/priceContainer"
                android:background="#f8f9fa"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@+id/ivDriverPhoto">
                <TextView
                    android:textSize="13sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estimated Fare"
                    android:fontFamily="@font/roboto_medium"/>
                <TextView
                    android:textSize="24sp"
                    android:textColor="?attr/colorOnSurface"
                    android:id="@+id/tvBaseRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="₹0"
                    android:fontFamily="@font/roboto_bold"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Your Offer (Customizable)"
                    android:fontFamily="@font/roboto_medium"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/tvMinus"
                        android:background="@drawable/button_background01"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="-"
                        android:backgroundTint="@color/black_text_01"/>
                    <EditText
                        android:textSize="24sp"
                        android:textColor="?attr/colorOnSurface"
                        android:gravity="center"
                        android:id="@+id/etCustomOffer"
                        android:background="@android:color/transparent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:layout_marginRight="12dp"
                        android:text="₹0"
                        android:layout_weight="1"
                        android:inputType="number"
                        android:fontFamily="@font/roboto_bold"
                        android:layout_marginHorizontal="12dp"/>
                    <TextView
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/tvPlus"
                        android:background="@drawable/button_background01"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="+"
                        android:backgroundTint="@color/black_text_01"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <ProgressBar
            android:id="@+id/searchProgress"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tilVehicleNumber"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@+id/driverFoundSection">
            <com.google.android.material.button.MaterialButton
                android:textColor="@color/red1"
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:text="Cancel"
                android:layout_weight="1"
                style="@style/Widget.MaterialComponents.Button.TextButton"/>
            <View
                android:layout_width="12dp"
                android:layout_height="1dp"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAction"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:text="SEARCH"
                android:layout_weight="1"
                app:cornerRadius="12dp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
