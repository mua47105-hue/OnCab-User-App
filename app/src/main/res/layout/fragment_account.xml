<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollIndicators="none"
        app:layout_constraintBottom_toTopOf="@+id/btnLogout"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/ccEmailPhone"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingVertical="10dp">
                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/profilePic"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/avatar_1"
                    app:civ_border_color="#eeeeee"
                    app:civ_border_width="1dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="16dp"
                    android:layout_toStartOf="@+id/ivNextArrow"
                    android:layout_toEndOf="@+id/profilePic">
                    <TextView
                        android:textSize="22sp"
                        android:textColor="@color/black"
                        android:id="@+id/userName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="User Name"
                        android:fontFamily="@font/roboto_bold"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="#666666"
                        android:id="@+id/phoneNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="9073806211"
                        android:fontFamily="@font/roboto"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="#666666"
                        android:id="@+id/email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="user@gmail.com"
                        android:fontFamily="@font/roboto"/>
                </LinearLayout>
                <ImageView
                    android:id="@+id/ivNextArrow"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/next"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    app:tint="#d1d1d1"/>
                <ImageView
                    android:id="@+id/backBtn"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="0dp"/>
            </RelativeLayout>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/ccFavouriteLocation"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="#f8f8f8"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">
                <RelativeLayout
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/ivLocIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/user"
                        android:layout_centerVertical="true"
                        app:tint="#888888"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_toStartOf="@+id/ivLocNext"
                        android:layout_toEndOf="@+id/ivLocIcon">
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/black"
                            android:id="@+id/tvLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Favourite Location"
                            android:fontFamily="@font/roboto_bold"/>
                        <TextView
                            android:textSize="13sp"
                            android:textColor="#999999"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Add homes, work, or frequent \10stops"
                            android:fontFamily="@font/roboto"/>
                    </LinearLayout>
                    <ImageView
                        android:id="@+id/ivLocNext"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/next"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"
                        app:tint="#d1d1d1"/>
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ccCards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="3">
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardSupport"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="1dp"
                        app:strokeColor="#f5f5f5"
                        app:strokeWidth="1dp">
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="16dp">
                            <ImageView
                                android:id="@+id/imageView39"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/support_02"
                                app:tint="@color/black"/>
                            <TextView
                                android:textSize="13sp"
                                android:textColor="@color/black"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Support"
                                android:fontFamily="@font/roboto_medium"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardPayment"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="1dp"
                        app:strokeColor="#f5f5f5"
                        app:strokeWidth="1dp">
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="16dp">
                            <ImageView
                                android:id="@+id/imageView01"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/wallet"
                                app:tint="@color/black"/>
                            <TextView
                                android:textSize="13sp"
                                android:textColor="@color/black"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Payment"
                                android:fontFamily="@font/roboto_medium"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardYourRides"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="1dp"
                        app:strokeColor="#f5f5f5"
                        app:strokeWidth="1dp">
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="16dp">
                            <ImageView
                                android:id="@+id/imageView02"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/clock"
                                app:tint="@color/black"/>
                            <TextView
                                android:textSize="13sp"
                                android:textColor="@color/black"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Your Rides"
                                android:fontFamily="@font/roboto_medium"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="3">
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardRefer"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="1dp"
                        app:strokeColor="#f5f5f5"
                        app:strokeWidth="1dp">
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="16dp">
                            <ImageView
                                android:id="@+id/imageView04"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/exchange"
                                app:tint="@color/black"/>
                            <TextView
                                android:textSize="13sp"
                                android:textColor="@color/black"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Refer"
                                android:fontFamily="@font/roboto_medium"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardAbout"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="1dp"
                        app:strokeColor="#f5f5f5"
                        app:strokeWidth="1dp">
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="16dp">
                            <ImageView
                                android:id="@+id/imageView05"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/info"
                                app:tint="@color/black"/>
                            <TextView
                                android:textSize="13sp"
                                android:textColor="@color/black"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="About"
                                android:fontFamily="@font/roboto_medium"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardSettings"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="1dp"
                        app:strokeColor="#f5f5f5"
                        app:strokeWidth="1dp">
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="16dp">
                            <ImageView
                                android:id="@+id/imageView06"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/setting"
                                app:tint="@color/black"/>
                            <TextView
                                android:textSize="13sp"
                                android:textColor="@color/black"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Settings"
                                android:fontFamily="@font/roboto_medium"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp">
                <FrameLayout
                    android:background="@drawable/bg_safe_ride_chip"
                    android:layout_width="48dp"
                    android:layout_height="48dp">
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/imageView6"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_shield_check"
                        app:tint="#0e7c55"/>
                </FrameLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp">
                    <TextView
                        android:textSize="17sp"
                        android:textColor="@color/black"
                        android:id="@+id/textView11"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Safety and Privacy"
                        android:fontFamily="@font/roboto_bold"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#888888"
                        android:id="@+id/textView12"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Manage account security and privacy"
                        android:fontFamily="@font/roboto"/>
                </LinearLayout>
            </LinearLayout>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#f0f0f0"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <RelativeLayout
                        android:id="@+id/cc2StepVerification"
                        android:padding="16dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/black"
                            android:id="@+id/TVerification"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2-Step verification"
                            android:fontFamily="@font/roboto_medium"/>
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/next"
                            android:layout_centerVertical="true"
                            android:layout_alignParentEnd="true"
                            app:tint="#d1d1d1"/>
                    </RelativeLayout>
                    <View
                        android:background="#f0f0f0"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginLeft="16dp"
                        android:layout_marginRight="16dp"
                        android:layout_marginHorizontal="16dp"/>
                    <RelativeLayout
                        android:id="@+id/emergencyContacts"
                        android:padding="16dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/black"
                            android:id="@+id/tvEmergencyContacts"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Emergency contacts"
                            android:fontFamily="@font/roboto_medium"/>
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/next"
                            android:layout_centerVertical="true"
                            android:layout_alignParentEnd="true"
                            app:tint="#d1d1d1"/>
                    </RelativeLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/makeMoreMoneyCard"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/black"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp">
                <RelativeLayout
                    android:padding="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/ivPartnerIconContainer"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_centerVertical="true"
                        app:cardBackgroundColor="#222222"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp">
                        <ImageView
                            android:layout_gravity="center"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/driver_icon"/>
                    </com.google.android.material.card.MaterialCardView>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="16dp"
                        android:layout_toStartOf="@+id/ivPartnerNext"
                        android:layout_toEndOf="@+id/ivPartnerIconContainer">
                        <TextView
                            android:textSize="18sp"
                            android:textColor="@color/white"
                            android:id="@+id/textView38"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Become an \10OnCab Partner"
                            android:fontFamily="@font/roboto_bold"/>
                        <TextView
                            android:textSize="13sp"
                            android:textColor="#aaaaaa"
                            android:id="@+id/textView42"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Turn your vehicle \10into extra income"
                            android:fontFamily="@font/roboto"/>
                    </LinearLayout>
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/ivPartnerNext"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp">
                        <ImageView
                            android:layout_gravity="center"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/next"
                            app:tint="@color/black"/>
                    </com.google.android.material.card.MaterialCardView>
                    <ImageView
                        android:id="@+id/imageView47"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="0dp"/>
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="17sp"
        android:textColor="@color/white"
        android:id="@+id/btnLogout"
        android:background="@drawable/button_bg_black"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="16dp"
        android:text="Log out"
        android:textAllCaps="false"
        android:fontFamily="@font/roboto_bold"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
