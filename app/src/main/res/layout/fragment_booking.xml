<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bookingFragment"
    android:background="#f5f5f5"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.fragment.app.FragmentContainerView
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:id="@+id/gMap"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/pulseContainer"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_marginBottom="190dp">
        <View
            android:layout_gravity="center"
            android:id="@+id/radiusCircle"
            android:background="@drawable/search_radius_fill"
            android:layout_width="260dp"
            android:layout_height="260dp"/>
        <View
            android:layout_gravity="center"
            android:id="@+id/pinShadow"
            android:background="@drawable/pin_shadow"
            android:layout_width="34dp"
            android:layout_height="10dp"
            android:layout_marginTop="2dp"
            android:alpha="0.35"/>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/pinBobber"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginBottom="28dp">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/location"
                app:tint="@color/black"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/driverBadgesContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/search_animation"
            android:visibility="gone"
            android:layout_width="1dp"
            android:layout_height="1dp"/>
        <View
            android:id="@+id/pulse1"
            android:visibility="gone"
            android:layout_width="1dp"
            android:layout_height="1dp"/>
        <View
            android:id="@+id/pulse2"
            android:visibility="gone"
            android:layout_width="1dp"
            android:layout_height="1dp"/>
        <View
            android:id="@+id/pulse3"
            android:visibility="gone"
            android:layout_width="1dp"
            android:layout_height="1dp"/>
    </FrameLayout>
    <androidx.cardview.widget.CardView
        android:id="@+id/cvBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:elevation="4dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="24dp">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/ivBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/back"
            app:tint="@color/black"/>
    </androidx.cardview.widget.CardView>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/bottomSheetContainer"
        android:background="@drawable/bottom_sheet_top_rounded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="16dp"
        app:behavior_peekHeight="300dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/viewHandle"
                android:background="#d1d1d1"
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_marginTop="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/llErrorState"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/viewHandle">
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/not_found_animation"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_marginTop="8dp"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_rawRes="@raw/not_found"/>
                <TextView
                    android:textSize="20sp"
                    android:textColor="@color/black"
                    android:id="@+id/tvErrorTitle"
                    android:paddingLeft="40dp"
                    android:paddingRight="40dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Server error please try later"
                    android:fontFamily="@font/roboto_bold"
                    android:textAlignment="center"
                    android:paddingHorizontal="40dp"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/llretry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="32dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginBottom="16dp"
                    android:layout_marginHorizontal="20dp">
                    <androidx.appcompat.widget.AppCompatButton
                        android:textSize="16sp"
                        android:textColor="@color/white"
                        android:id="@+id/retryRideBtn"
                        android:background="@drawable/button_bg_black"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:text="Retry"
                        android:layout_weight="1"
                        android:textAllCaps="false"
                        android:fontFamily="@font/roboto_bold"
                        android:layout_marginEnd="10dp"/>
                    <androidx.appcompat.widget.AppCompatButton
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:id="@+id/cancelRideBtnNew"
                        android:background="@drawable/button_bg_outline"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:text="Cancel"
                        android:layout_weight="1"
                        android:textAllCaps="false"
                        android:fontFamily="@font/roboto_bold"
                        android:layout_marginStart="10dp"/>
                </LinearLayout>
            </LinearLayout>
            <RelativeLayout
                android:id="@+id/rlTitleContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="24dp"
                android:layout_marginHorizontal="24dp"
                app:layout_constraintTop_toBottomOf="@+id/viewHandle">
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/black"
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Looking for a safe and\10hygienic ride nearby"
                    android:fontFamily="@font/roboto_bold"
                    android:layout_toStartOf="@+id/tvNewBadge"
                    android:layout_alignParentStart="true"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/white"
                    android:id="@+id/tvNewBadge"
                    android:background="@drawable/bg_black_rounded_small"
                    android:paddingLeft="10dp"
                    android:paddingTop="4dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="new"
                    android:fontFamily="@font/roboto_bold"
                    android:layout_alignParentEnd="true"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"/>
            </RelativeLayout>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/grey"
                android:id="@+id/tvSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="4dp"
                android:layout_marginRight="24dp"
                android:text="Drivers nearby are reviewing your offer"
                android:fontFamily="@font/roboto"
                android:layout_marginHorizontal="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rlTitleContainer"/>
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/rideProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:indeterminate="true"
                app:indicatorColor="@color/my_color_primary"
                app:layout_constraintTop_toBottomOf="@+id/tvSubtitle"
                app:trackColor="#f0f0f0"
                app:trackThickness="3dp"/>
            <androidx.cardview.widget.CardView
                android:id="@+id/cvDriversSeen"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="15dp"
                android:layout_marginRight="16dp"
                android:layout_marginHorizontal="16dp"
                app:cardBackgroundColor="#f9f9f5"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@+id/rideProgress">
                <RelativeLayout
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <FrameLayout
                        android:id="@+id/flAvatars"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true">
                        <de.hdodenhof.circleimageview.CircleImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/driver"
                            app:civ_border_color="@color/white"
                            app:civ_border_width="2dp"/>
                        <de.hdodenhof.circleimageview.CircleImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/driver"
                            android:layout_marginStart="18dp"
                            app:civ_border_color="@color/white"
                            app:civ_border_width="2dp"/>
                        <de.hdodenhof.circleimageview.CircleImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/driver"
                            android:layout_marginStart="36dp"
                            app:civ_border_color="@color/white"
                            app:civ_border_width="2dp"/>
                    </FrameLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="12dp"
                        android:layout_toStartOf="@+id/ivStatusDot"
                        android:layout_toEndOf="@+id/flAvatars">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/black"
                            android:id="@+id/tvDriversSeenCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5 drivers have seen your request"
                            android:fontFamily="@font/roboto_bold"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/grey"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Updated just now"
                            android:fontFamily="@font/roboto"/>
                    </LinearLayout>
                    <ImageView
                        android:id="@+id/ivStatusDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:src="@drawable/circle_pulse"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"
                        app:tint="#2e7d32"/>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:id="@+id/cvTripSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="15dp"
                android:layout_marginRight="16dp"
                android:layout_marginHorizontal="16dp"
                app:cardBackgroundColor="#f8f9fa"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@+id/rideProgress">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <View
                            android:background="@drawable/circle_pulse"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:backgroundTint="#03a9f4"/>
                        <TextView
                            android:textSize="15sp"
                            android:textColor="#333333"
                            android:ellipsize="end"
                            android:id="@+id/tvBookingSource"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Pickup location"
                            android:maxLines="1"
                            android:fontFamily="@font/roboto"
                            android:layout_marginStart="14dp"/>
                    </LinearLayout>
                    <View
                        android:background="#e0e0e0"
                        android:layout_width="1dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="4.5dp"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <View
                            android:background="@drawable/circle_pulse"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:backgroundTint="#f44336"/>
                        <TextView
                            android:textSize="15sp"
                            android:textColor="#333333"
                            android:ellipsize="end"
                            android:id="@+id/tvBookingDest"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Destination location"
                            android:maxLines="1"
                            android:fontFamily="@font/roboto"
                            android:layout_marginStart="14dp"/>
                    </LinearLayout>
                    <View
                        android:background="#eeeeee"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="18dp"
                        android:layout_marginBottom="18dp"
                        android:layout_marginVertical="18dp"/>
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <ImageView
                                android:id="@+id/ivPaymentMode"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/cash"/>
                            <TextView
                                android:textSize="13sp"
                                android:textColor="@color/grey"
                                android:id="@+id/tvPaymentType"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CASH"
                                android:fontFamily="@font/roboto_bold"
                                android:layout_marginStart="10dp"/>
                        </LinearLayout>
                        <TextView
                            android:textSize="20sp"
                            android:textColor="@color/black"
                            android:id="@+id/tvBookingAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹0"
                            android:fontFamily="@font/roboto_bold"
                            android:layout_alignParentEnd="true"/>
                    </RelativeLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.appcompat.widget.AppCompatButton
                android:textSize="17sp"
                android:textColor="@color/white"
                android:id="@+id/cancelRide1"
                android:background="@drawable/button_bg_black"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="24dp"
                android:layout_marginRight="16dp"
                android:text="Cancel Ride"
                android:alpha="0"
                android:textAllCaps="false"
                android:fontFamily="@font/roboto_bold"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintTop_toBottomOf="@+id/cvTripSummary"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/llProgress"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/cancelRideBtn"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
