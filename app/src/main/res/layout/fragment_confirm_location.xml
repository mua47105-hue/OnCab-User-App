<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <fragment
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:id="@+id/gMap"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/cvBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/ivBack"
                android:layout_width="24dp"
                android:layout_height="27dp"
                android:src="@drawable/back"
                app:tint="@color/black"/>
        </androidx.cardview.widget.CardView>
    </FrameLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/booking_item_bottomsheet"
        android:background="@drawable/top_rounded_rectangle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="8dp"
        app:behavior_draggable="true"
        app:behavior_hideable="false"
        app:behavior_peekHeight="540dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingLeft="16dp"
            android:paddingTop="12dp"
            android:paddingRight="16dp"
            android:paddingBottom="160dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp">
            <View
                android:id="@+id/dragHandle"
                android:background="#d1d1d6"
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_marginTop="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/materialCardView6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:layout_constraintTop_toBottomOf="@+id/dragHandle"
                app:strokeWidth="0dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <View
                        android:id="@+id/view13"
                        android:background="#d1d1d6"
                        android:layout_width="1dp"
                        android:layout_height="0dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"
                        app:layout_constraintBottom_toTopOf="@+id/imageView1"
                        app:layout_constraintEnd_toEndOf="@+id/imageView36"
                        app:layout_constraintStart_toStartOf="@+id/imageView36"
                        app:layout_constraintTop_toBottomOf="@+id/imageView36"/>
                    <ImageView
                        android:id="@+id/imageView36"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/circle"
                        app:layout_constraintBottom_toBottomOf="@+id/tvSourceAddress"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tvSourceAddress"
                        app:tint="@color/green"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        android:ellipsize="end"
                        android:id="@+id/tvSourceAddress"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Pickup Location"
                        android:singleLine="true"
                        android:fontFamily="@font/roboto_medium"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="8dp"
                        app:layout_constraintEnd_toStartOf="@+id/driverPic"
                        app:layout_constraintStart_toEndOf="@+id/imageView36"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ImageView
                        android:id="@+id/imageView1"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginTop="24dp"
                        android:src="@drawable/circle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvSourceAddress"
                        app:tint="@color/red"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        android:ellipsize="end"
                        android:id="@+id/tvDestinationAddress"
                        android:background="?attr/selectableItemBackground"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Destination Location"
                        android:singleLine="true"
                        android:fontFamily="@font/roboto_bold"
                        android:layout_marginStart="16dp"
                        app:layout_constraintBottom_toBottomOf="@+id/imageView1"
                        app:layout_constraintEnd_toStartOf="@+id/driverPic"
                        app:layout_constraintStart_toEndOf="@+id/imageView1"
                        app:layout_constraintTop_toTopOf="@+id/imageView1"/>
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/driverPic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="#f2f2f7"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/selectTimeClock"
                            android:paddingLeft="12dp"
                            android:paddingTop="8dp"
                            android:paddingRight="12dp"
                            android:paddingBottom="8dp"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="8dp">
                            <ImageView
                                android:id="@+id/imageView42"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/alarm"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:tint="@color/black"/>
                            <TextView
                                android:textSize="11sp"
                                android:textColor="@color/black"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Now"
                                android:fontFamily="@font/roboto_medium"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/imageView42"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/selectTimeClockValue"
                            android:padding="8dp"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/black"
                                android:id="@+id/tvDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="13 Jan"
                                android:fontFamily="@font/roboto_bold"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <TextView
                                android:textSize="11sp"
                                android:textColor="@color/grey"
                                android:id="@+id/tvTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="03:35 pm"
                                android:fontFamily="@font/roboto_medium"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/tvDate"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <ImageView
                        android:id="@+id/imageView38"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="0dp"/>
                    <ImageView
                        android:id="@+id/ivStopCircle"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="0dp"/>
                    <TextView
                        android:id="@+id/tvStoppageAddress"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="0dp"/>
                    <ImageView
                        android:id="@+id/ivStopToDestLine"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="0dp"/>
                    <androidx.constraintlayout.widget.Guideline
                        android:orientation="horizontal"
                        android:id="@+id/guideline6"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintGuide_percent="0.5"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRentType"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@+id/materialCardView6"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRentalHrKm"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@+id/rvRentType"/>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvOutstationTripTypeToggle"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="#f2f2f7"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@+id/rvRentalHrKm">
                <LinearLayout
                    android:orientation="horizontal"
                    android:padding="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnOneWay"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="2dp">
                        <TextView
                            android:textSize="13sp"
                            android:layout_gravity="center"
                            android:id="@+id/tvOneWay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="One Way"
                            android:fontFamily="@font/roboto_bold"/>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnRoundTrip"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@android:color/transparent"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp">
                        <TextView
                            android:textSize="13sp"
                            android:layout_gravity="center"
                            android:id="@+id/tvRoundTrip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Round Trip"
                            android:fontFamily="@font/roboto_medium"/>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCars"
                android:paddingBottom="110dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@+id/cvOutstationTripTypeToggle"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <androidx.cardview.widget.CardView
        android:layout_gravity="bottom"
        android:id="@+id/cv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="0dp"
        app:cardElevation="16dp">
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/white"
            android:paddingBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clPaymentOptions"
                android:layout_width="match_parent"
                android:layout_height="56dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/clCash"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    app:layout_constraintEnd_toStartOf="@+id/divider9"
                    app:layout_constraintStart_toStartOf="parent">
                    <ImageView
                        android:id="@+id/imageView41"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/cash"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/paymentType"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        android:id="@+id/paymentType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cash"
                        android:fontFamily="@font/roboto_medium"
                        android:layout_marginStart="8dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/imageView41"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <View
                    android:id="@+id/divider9"
                    android:background="#e5e5ea"
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/clCoupon"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/divider9">
                    <ImageView
                        android:id="@+id/imageView001"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/coupon"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/couponText"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        android:id="@+id/couponText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Coupon &amp; Offers"
                        android:fontFamily="@font/roboto_medium"
                        android:layout_marginStart="8dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/imageView001"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <View
                    android:orientation="vertical"
                    android:id="@+id/guideline5"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintGuide_percent="0.5"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/llPriceNegotiation"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:paddingBottom="16dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp">
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/grey"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Offer your fare"
                    android:textAllCaps="true"
                    android:letterSpacing="0.05"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:textSize="28sp"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:id="@+id/tvMinusFare"
                        android:background="@drawable/button_background01"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:text="-"
                        android:backgroundTint="#f2f2f7"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_marginRight="20dp"
                        android:layout_marginHorizontal="20dp">
                        <TextView
                            android:textSize="26sp"
                            android:textColor="@color/black"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹"
                            android:fontFamily="@font/roboto_bold"/>
                        <EditText
                            android:textSize="26sp"
                            android:textColor="@color/black"
                            android:gravity="center"
                            android:id="@+id/etNegotiablePrice"
                            android:background="@android:color/transparent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="60dp"
                            android:text="0"
                            android:inputType="number"
                            android:fontFamily="@font/roboto_bold"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="28sp"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:id="@+id/tvPlusFare"
                        android:background="@drawable/button_background01"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:text="+"
                        android:backgroundTint="#f2f2f7"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/walletBreakdownCard"
                android:background="@drawable/button_background01"
                android:padding="12dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="#f1f8e9"
                android:layout_marginHorizontal="20dp">
                <TextView
                    android:textSize="13sp"
                    android:textColor="#2e7d32"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Wallet balance applied"
                    android:layout_weight="1"
                    android:fontFamily="@font/roboto_medium"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="#2e7d32"
                    android:id="@+id/tvWalletBalanceHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_bold"/>
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatButton
                android:textSize="16sp"
                android:textColor="@color/white"
                android:id="@+id/bookCab"
                android:background="@drawable/button_background01"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:text="Book Car"
                android:textAllCaps="false"
                android:fontFamily="@font/roboto_bold"
                android:backgroundTint="@color/black"
                android:layout_marginHorizontal="20dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
