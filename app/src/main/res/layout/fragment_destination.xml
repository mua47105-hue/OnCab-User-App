<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <fragment
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout4"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/back"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="18sp"
            android:textColor="?attr/colorOnSurface"
            android:id="@+id/tvHeaderText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:text="@string/select_destination"
            android:fontFamily="@font/roboto_medium"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivBack"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout3"
            android:background="@drawable/border_background_black"
            android:paddingLeft="16dp"
            android:paddingTop="8dp"
            android:paddingRight="16dp"
            android:paddingBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="5dp"
            android:layout_marginRight="16dp"
            android:backgroundTint="@color/white"
            android:layout_marginHorizontal="16dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/tvHeaderText"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvHeaderText">
            <ImageView
                android:id="@+id/imageView17"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/avatar_1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:id="@+id/userType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/myself"
                android:fontFamily="@font/roboto"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintBottom_toBottomOf="@+id/imageView17"
                app:layout_constraintEnd_toStartOf="@+id/imageView18"
                app:layout_constraintStart_toEndOf="@+id/imageView17"
                app:layout_constraintTop_toTopOf="@+id/imageView18"/>
            <ImageView
                android:id="@+id/imageView18"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/down_arrow"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/green"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/materialCardView4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:cardCornerRadius="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/constraintLayout4">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:padding="8dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraintLayout5"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <LinearLayout
                    android:gravity="start|center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/cardNormalPickupLocation"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <ImageView
                        android:id="@+id/greenDot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:src="@drawable/circle1"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="?attr/colorOnSurface"
                        android:id="@+id/selectLocationTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pickup_location"
                        android:fontFamily="@font/roboto"
                        android:layout_marginStart="12dp"/>
                </LinearLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:gravity="start|center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/cardPickupLocation"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <ImageView
                        android:id="@+id/largeGreenDot"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/circle"
                        android:layout_marginStart="8dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/green"/>
                    <ImageView
                        android:id="@+id/imageView19"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/arrow_01"
                        android:layout_marginStart="12dp"
                        app:layout_constraintBottom_toBottomOf="@+id/largeGreenDot"
                        app:layout_constraintStart_toEndOf="@+id/largeGreenDot"
                        app:layout_constraintTop_toTopOf="@+id/largeGreenDot"
                        app:tint="@color/green"/>
                    <TextView
                        android:textSize="15sp"
                        android:textColor="?attr/colorOnSurface"
                        android:textColorHint="@color/grey"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:id="@+id/pickupLocation"
                        android:background="@color/transparent"
                        android:focusable="false"
                        android:clickable="true"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:hint="@string/enter_pickup_location"
                        android:singleLine="true"
                        android:fontFamily="@font/roboto"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        app:layout_constraintBottom_toBottomOf="@+id/imageView19"
                        app:layout_constraintEnd_toStartOf="@+id/imageView20"
                        app:layout_constraintStart_toEndOf="@+id/imageView19"
                        app:layout_constraintTop_toTopOf="@+id/imageView19"/>
                    <ImageView
                        android:id="@+id/imageView20"
                        android:visibility="gone"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/delete"
                        android:layout_marginEnd="8dp"
                        app:layout_constraintBottom_toBottomOf="@+id/pickupLocation"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/pickupLocation"
                        app:tint="@color/grey"/>
                    <View
                        android:background="@color/SecondaryTextColor"
                        android:layout_width="0.8dp"
                        android:layout_height="0dp"
                        android:layout_marginTop="2dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@+id/largeGreenDot"
                        app:layout_constraintStart_toStartOf="@+id/largeGreenDot"
                        app:layout_constraintTop_toBottomOf="@+id/largeGreenDot"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:gravity="start|center_vertical"
                android:orientation="horizontal"
                android:id="@+id/cardDestinationLocation1"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/constraintLayout5">
                <ImageView
                    android:id="@+id/largeRedDot"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/circle"
                    android:layout_marginStart="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/red"/>
                <ImageView
                    android:id="@+id/imageView1"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/arrow_01"
                    android:layout_marginStart="12dp"
                    app:layout_constraintBottom_toBottomOf="@+id/largeRedDot"
                    app:layout_constraintStart_toEndOf="@+id/largeRedDot"
                    app:layout_constraintTop_toTopOf="@+id/largeRedDot"
                    app:tint="@color/red"/>
                <AutoCompleteTextView
                    android:textSize="15sp"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="@color/grey"
                    android:ellipsize="end"
                    android:gravity="start|center_vertical"
                    android:id="@+id/tvDestinationLocation"
                    android:background="@color/transparent"
                    android:focusable="false"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:hint="@string/select_destination"
                    android:cursorVisible="false"
                    android:singleLine="true"
                    android:fontFamily="@font/roboto"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintBottom_toBottomOf="@+id/imageView1"
                    app:layout_constraintEnd_toStartOf="@+id/ivAddAnotherDestination"
                    app:layout_constraintStart_toEndOf="@+id/imageView1"
                    app:layout_constraintTop_toTopOf="@+id/imageView1"/>
                <ImageView
                    android:id="@+id/ivAddAnotherDestination"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/add"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintBottom_toBottomOf="@+id/tvDestinationLocation"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tvDestinationLocation"
                    app:tint="@color/green"/>
                <View
                    android:id="@+id/view3"
                    android:background="@color/SecondaryTextColor"
                    android:layout_width="0.8dp"
                    android:layout_height="0dp"
                    android:layout_marginBottom="2dp"
                    app:layout_constraintBottom_toTopOf="@+id/largeRedDot"
                    app:layout_constraintEnd_toEndOf="@+id/largeRedDot"
                    app:layout_constraintStart_toStartOf="@+id/largeRedDot"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:gravity="start|center_vertical"
                android:orientation="horizontal"
                android:id="@+id/cardDestinationLocation2"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cardDestinationLocation1">
                <ImageView
                    android:id="@+id/largeRedDot1"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/circle"
                    android:layout_marginStart="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/red"/>
                <ImageView
                    android:id="@+id/imageView4"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/arrow_01"
                    android:layout_marginStart="12dp"
                    app:layout_constraintBottom_toBottomOf="@+id/largeRedDot1"
                    app:layout_constraintStart_toEndOf="@+id/largeRedDot1"
                    app:layout_constraintTop_toTopOf="@+id/largeRedDot1"
                    app:tint="@color/red"/>
                <AutoCompleteTextView
                    android:textSize="15sp"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="@color/grey"
                    android:ellipsize="end"
                    android:gravity="start|center_vertical"
                    android:id="@+id/tvDestinationLocation2"
                    android:background="@color/transparent"
                    android:focusable="false"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:hint="@string/select_destination"
                    android:cursorVisible="false"
                    android:singleLine="true"
                    android:fontFamily="@font/roboto"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintBottom_toBottomOf="@+id/imageView4"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/imageView4"
                    app:layout_constraintTop_toTopOf="@+id/imageView4"/>
                <View
                    android:background="@color/SecondaryTextColor"
                    android:layout_width="0.8dp"
                    android:layout_height="0dp"
                    android:layout_marginBottom="2dp"
                    app:layout_constraintBottom_toTopOf="@+id/largeRedDot1"
                    app:layout_constraintEnd_toEndOf="@+id/largeRedDot1"
                    app:layout_constraintStart_toStartOf="@+id/largeRedDot1"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clSavedLocations"
        android:background="?attr/colorSurface"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:elevation="1dp"
        app:layout_constraintTop_toBottomOf="@+id/materialCardView4">
        <TextView
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurface"
            android:id="@+id/tvSavedHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Saved Locations"
            android:fontFamily="@font/roboto_bold"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSavedLocations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvSavedHeader"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/llCenterPin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:translationY="-20dp"
        app:layout_constraintBottom_toBottomOf="@+id/map"
        app:layout_constraintEnd_toEndOf="@+id/map"
        app:layout_constraintStart_toStartOf="@+id/map"
        app:layout_constraintTop_toTopOf="@+id/map">
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvPinAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/black"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp"
            app:strokeWidth="0dp">
            <TextView
                android:textSize="13sp"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:id="@+id/tvPinAddress"
                android:paddingLeft="16dp"
                android:paddingTop="8dp"
                android:paddingRight="16dp"
                android:paddingBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="160dp"
                android:text="Set destination"
                android:singleLine="true"
                android:fontFamily="@font/roboto_bold"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"/>
        </com.google.android.material.card.MaterialCardView>
        <View
            android:background="@color/black"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginTop="-6dp"
            android:rotation="45"/>
        <ImageView
            android:id="@+id/ivCenterPin"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="2dp"
            android:src="@drawable/red_marker"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="16sp"
        android:textColor="@color/white"
        android:id="@+id/btnConfirm"
        android:background="@drawable/button_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_margin="16dp"
        android:text="Confirm Route"
        android:textAllCaps="false"
        android:fontFamily="@font/roboto_medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
