<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/colorBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout4"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/back"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="16sp"
            android:textColor="?attr/colorOnSurface"
            android:id="@+id/tvHeaderText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:text="Your Route"
            android:fontFamily="@font/roboto_medium"
            android:layout_marginStart="15dp"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivBack"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.473"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="start|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/linearPickUpLocation"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/constraintLayout4">
        <ImageView
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/circle1"
            app:tint="@color/green"/>
        <TextView
            android:textSize="15sp"
            android:textColor="?attr/colorOnSurface"
            android:ellipsize="end"
            android:id="@+id/pickUpLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your Pickup Location"
            android:maxLines="1"
            android:singleLine="true"
            android:fontFamily="@font/roboto"
            android:layout_marginStart="12dp"/>
    </LinearLayout>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/materialCardView4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="10dp"
        app:layout_constraintEnd_toEndOf="@+id/linearPickUpLocation"
        app:layout_constraintStart_toStartOf="@+id/linearPickUpLocation"
        app:layout_constraintTop_toBottomOf="@+id/linearPickUpLocation">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:padding="8dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:id="@+id/view01"
                android:background="@color/lightGray"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:gravity="start|center_vertical"
                android:orientation="horizontal"
                android:id="@+id/cardPickupLocation"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                app:layout_constraintBottom_toTopOf="@+id/view01"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/firstLocationRedDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/circle1"
                    android:layout_marginStart="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/light_red"/>
                <ImageView
                    android:id="@+id/cancelFirstLocation"
                    android:visibility="gone"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/remove"
                    app:layout_constraintBottom_toBottomOf="@+id/firstLocationRedDot"
                    app:layout_constraintEnd_toEndOf="@+id/firstLocationRedDot"
                    app:layout_constraintStart_toStartOf="@+id/firstLocationRedDot"
                    app:layout_constraintTop_toTopOf="@+id/firstLocationRedDot"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/SecondaryTextColor"
                    android:textColorHint="@color/grey"
                    android:ellipsize="end"
                    android:gravity="start|center_vertical"
                    android:id="@+id/tvPickupLocation"
                    android:background="@color/transparent"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:hint="Add a stop"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:fontFamily="@font/roboto"
                    android:layout_marginStart="16dp"
                    app:layout_constraintBottom_toBottomOf="@+id/firstLocationRedDot"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/cancelFirstLocation"
                    app:layout_constraintTop_toTopOf="@+id/firstLocationRedDot"/>
                <View
                    android:id="@+id/view4"
                    android:background="@color/SecondaryTextColor"
                    android:layout_width="0.8dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@+id/firstLocationRedDot"
                    app:layout_constraintStart_toStartOf="@+id/firstLocationRedDot"
                    app:layout_constraintTop_toBottomOf="@+id/firstLocationRedDot"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:gravity="start|center_vertical"
                android:orientation="horizontal"
                android:id="@+id/cardPickupLocation2"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view01">
                <ImageView
                    android:id="@+id/secondLocationRedDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/circle1"
                    android:layout_marginStart="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/light_red"/>
                <ImageView
                    android:id="@+id/cancelSecondLocation"
                    android:visibility="gone"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/remove"
                    app:layout_constraintBottom_toBottomOf="@+id/secondLocationRedDot"
                    app:layout_constraintEnd_toEndOf="@+id/secondLocationRedDot"
                    app:layout_constraintStart_toStartOf="@+id/secondLocationRedDot"
                    app:layout_constraintTop_toTopOf="@+id/secondLocationRedDot"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/SecondaryTextColor"
                    android:textColorHint="@color/grey"
                    android:ellipsize="end"
                    android:gravity="start|center_vertical"
                    android:id="@+id/tvPickupLocation2"
                    android:background="@color/transparent"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:hint="Add a stop"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:fontFamily="@font/roboto"
                    android:layout_marginStart="16dp"
                    app:layout_constraintBottom_toBottomOf="@+id/secondLocationRedDot"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/cancelSecondLocation"
                    app:layout_constraintTop_toTopOf="@+id/secondLocationRedDot"/>
                <View
                    android:id="@+id/view5"
                    android:background="@color/SecondaryTextColor"
                    android:layout_width="0.8dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toTopOf="@+id/secondLocationRedDot"
                    app:layout_constraintEnd_toEndOf="@+id/secondLocationRedDot"
                    app:layout_constraintStart_toStartOf="@+id/secondLocationRedDot"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabSwap"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/swap"
                android:scaleType="centerInside"
                android:foregroundGravity="center"
                android:backgroundTint="?attr/colorOnSurface"
                app:fabCustomSize="44dp"
                app:layout_constraintBottom_toBottomOf="@+id/view01"
                app:layout_constraintEnd_toEndOf="@+id/view01"
                app:layout_constraintTop_toTopOf="@+id/view01"
                app:maxImageSize="22dp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
    <fragment
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        app:layout_constraintBottom_toTopOf="@+id/constraintLayout6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/materialCardView4"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout6"
        android:background="?attr/colorSurface"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/imageView21"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/location"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/textView19"
            app:layout_constraintEnd_toStartOf="@+id/textView19"
            app:layout_constraintTop_toTopOf="@+id/textView19"/>
        <TextView
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurface"
            android:id="@+id/textView19"
            android:layout_width="wrap_content"
            android:layout_height="19dp"
            android:text="Locate on Map"
            android:fontFamily="@font/roboto"
            android:layout_marginStart="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:id="@+id/llConfirm"
        android:background="?attr/colorSurface"
        android:paddingLeft="16dp"
        android:paddingTop="18dp"
        android:paddingRight="16dp"
        android:paddingBottom="18dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="18dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <Button
            android:textSize="16sp"
            android:textColor="@color/button_text"
            android:id="@+id/btnConfirmRoute"
            android:background="@drawable/button_background"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Confirm Route"
            android:textAllCaps="false"
            android:fontFamily="@font/roboto"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
