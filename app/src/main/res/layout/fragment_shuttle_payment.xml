<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#eaf5f1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/back"
            app:tint="@color/black"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/black"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Payment"
            android:fontFamily="@font/roboto_bold"/>
    </androidx.appcompat.widget.Toolbar>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/btnPay"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/grey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trip Details"
                android:fontFamily="@font/roboto_medium"/>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/ivBus"
                        android:background="@drawable/busiconone"
                        android:padding="10dp"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_shuttle_bus"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:id="@+id/tvRoute"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Kolkata -&gt; Airport"
                        android:fontFamily="@font/roboto_bold"
                        android:layout_marginStart="16dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/ivBus"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/grey"
                        android:id="@+id/tvTime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="04 Sep 2026 | 08:30 AM"
                        android:fontFamily="@font/roboto"
                        app:layout_constraintStart_toStartOf="@+id/tvRoute"
                        app:layout_constraintTop_toBottomOf="@+id/tvRoute"/>
                    <View
                        android:id="@+id/divider"
                        android:background="#f0f0f0"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        app:layout_constraintTop_toBottomOf="@+id/tvTime"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/grey"
                        android:id="@+id/tvSeatsLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Seats"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/divider"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        android:id="@+id/tvSeats"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="A4, A5"
                        android:fontFamily="@font/roboto_bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvSeatsLabel"/>
                    <LinearLayout
                        android:gravity="end|center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/layoutPriceGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="@+id/tvSeats"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tvSeatsLabel">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/grey"
                            android:id="@+id/tvOriginalAmount"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto"
                            android:layout_marginEnd="6dp"/>
                        <TextView
                            android:textSize="20sp"
                            android:textColor="@color/black"
                            android:id="@+id/tvTotalAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹ 0"
                            android:fontFamily="@font/roboto_bold"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/layoutCouponApplied"
                        android:background="#e8f5e9"
                        android:paddingLeft="12dp"
                        android:paddingTop="8dp"
                        android:paddingRight="12dp"
                        android:paddingBottom="8dp"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvSeats">
                        <TextView
                            android:textSize="12sp"
                            android:textColor="#2e7d32"
                            android:id="@+id/tvCouponAppliedText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="�� FEE-COUPAN applied • First Ride Free!"
                            android:fontFamily="@font/roboto_medium"/>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/grey"
                android:id="@+id/tvCouponsHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Coupons &amp; Offers"
                android:fontFamily="@font/roboto_medium"/>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCouponSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeColor="#e5e7eb"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/layoutActiveCoupon"
                        android:background="?attr/selectableItemBackground"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="4dp">
                        <TextView
                            android:textSize="22sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="��️"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp">
                            <TextView
                                android:textSize="14sp"
                                android:textColor="#1b5e20"
                                android:id="@+id/tvCouponTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="FREE-RIDE"
                                android:fontFamily="@font/roboto_bold"/>
                            <TextView
                                android:textSize="12sp"
                                android:textColor="#4b5563"
                                android:id="@+id/tvCouponDesc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="100% OFF on 1st ride • Enjoy free ride!"
                                android:fontFamily="@font/roboto"/>
                        </LinearLayout>
                        <TextView
                            android:textSize="13sp"
                            android:textColor="#2e7d32"
                            android:id="@+id/btnCouponAction"
                            android:background="@drawable/round_corner"
                            android:paddingLeft="14dp"
                            android:paddingTop="7dp"
                            android:paddingRight="14dp"
                            android:paddingBottom="7dp"
                            android:focusable="true"
                            android:clickable="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="APPLY"
                            android:fontFamily="@font/roboto_bold"
                            android:backgroundTint="#e8f5e9"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="7dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/layoutManualCouponInput"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            app:cardBackgroundColor="#f9fafb"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="0dp"
                            app:strokeColor="#d1d5db"
                            app:strokeWidth="1dp">
                            <EditText
                                android:textSize="13sp"
                                android:textColor="@color/black"
                                android:id="@+id/etCouponCode"
                                android:background="@null"
                                android:paddingLeft="12dp"
                                android:paddingRight="12dp"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:hint="Enter coupon code"
                                android:singleLine="true"
                                android:inputType="textCapCharacters"
                                android:paddingHorizontal="12dp"/>
                        </com.google.android.material.card.MaterialCardView>
                        <TextView
                            android:textSize="13sp"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:id="@+id/btnApplyManualCoupon"
                            android:background="@drawable/button_background"
                            android:paddingLeft="16dp"
                            android:paddingRight="16dp"
                            android:focusable="true"
                            android:clickable="true"
                            android:layout_width="wrap_content"
                            android:layout_height="42dp"
                            android:text="Apply"
                            android:fontFamily="@font/roboto_bold"
                            android:layout_marginStart="8dp"
                            android:paddingHorizontal="16dp"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#2563eb"
                        android:id="@+id/tvManualCouponToggle"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Have another coupon code? Enter manually"
                        android:fontFamily="@font/roboto"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/grey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Select Payment Method"
                android:fontFamily="@font/roboto_medium"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/llPaymentMethods"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cvOnlinePayment"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/green"
                    app:strokeWidth="2dp">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:src="@drawable/online_payment"
                            android:scaleType="centerInside"
                            android:contentDescription="Online Payment"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp">
                            <TextView
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#111827"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Online Payment"
                                android:fontFamily="@font/roboto"/>
                            <TextView
                                android:textSize="12sp"
                                android:textColor="#6b7280"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="UPI (GPay, PhonePe, Paytm), Cards &amp; Net Banking"
                                android:fontFamily="@font/roboto"/>
                        </LinearLayout>
                        <RadioButton
                            android:id="@+id/rbOnlinePayment"
                            android:focusable="false"
                            android:clickable="false"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:buttonTint="@color/green"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cvWallet"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#e5e7eb"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:src="@drawable/wallet"
                            android:scaleType="centerInside"
                            android:contentDescription="Wallet"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp">
                            <TextView
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#111827"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="OnCab Wallet"
                                android:fontFamily="@font/roboto"/>
                            <TextView
                                android:textSize="12sp"
                                android:textColor="#6b7280"
                                android:id="@+id/tvWallet"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Wallet  •  ₹0"
                                android:fontFamily="@font/roboto"/>
                        </LinearLayout>
                        <RadioButton
                            android:id="@+id/rbWallet"
                            android:focusable="false"
                            android:clickable="false"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false"
                            android:buttonTint="@color/green"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRefundPolicy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="#f0fdf4"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="#bbf7d0"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/ivRefundIcon"
                        android:background="@drawable/bg_refund_policy_badge"
                        android:padding="7dp"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/wallet"
                        android:contentDescription="Wallet Refund"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp">
                        <TextView
                            android:textSize="13sp"
                            android:textColor="#166534"
                            android:id="@+id/tvRefundPolicyTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cancellation &amp; Refund Policy"
                            android:fontFamily="@font/roboto_bold"/>
                        <TextView
                            android:textSize="11.5sp"
                            android:textColor="#374151"
                            android:id="@+id/tvRefundPolicyNote"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="If you cancel this booking later, eligible refund will be credited directly to your OnCab Wallet for future rides."
                            android:lineSpacingExtra="2dp"
                            android:fontFamily="@font/roboto"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="16sp"
        android:textColor="@color/white"
        android:id="@+id/btnPay"
        android:background="@drawable/button_background"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_margin="16dp"
        android:text="Pay ₹ 700"
        android:textAllCaps="false"
        android:fontFamily="@font/roboto_bold"
        android:backgroundTint="#0e6047"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
