<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#eaf5f1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/ivBack"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/back"
                app:tint="@color/black"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/black"
                android:ellipsize="end"
                android:id="@+id/tvRouteHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_weight="1"
                android:fontFamily="@font/roboto_bold"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="8dp"/>
            <ImageView
                android:id="@+id/ivEditRoute"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_pencil_edit"
                android:layout_marginEnd="16dp"
                app:tint="@color/black"/>
        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDateScroll"
        android:background="@color/white"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <View
        android:id="@+id/dividerDate"
        android:background="#e2e8f0"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintTop_toBottomOf="@+id/rvDateScroll"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llBannerContainer"
        android:background="#eaf5f1"
        android:paddingLeft="6dp"
        android:paddingTop="8dp"
        android:paddingRight="6dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="6dp"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toBottomOf="@+id/dividerDate">
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/vpBanners"
            android:layout_width="match_parent"
            android:layout_height="130dp"/>
    </LinearLayout>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPromoBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="14dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="14dp"
        android:layout_marginHorizontal="14dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:layout_constraintTop_toBottomOf="@+id/llBannerContainer"
        app:strokeWidth="0dp">
        <RelativeLayout
            android:background="@drawable/bg_oncab_banner"
            android:paddingLeft="16dp"
            android:paddingTop="10dp"
            android:paddingRight="16dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">
            <ImageView
                android:id="@+id/ivPromoBus"
                android:background="@drawable/border_background_01"
                android:padding="1dp"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/busicon"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                android:backgroundTint="#33ffffff"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_toStartOf="@+id/tvPromoOfferBadge"
                android:layout_toEndOf="@+id/ivPromoBus">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:id="@+id/tvPromoTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1st Ride FREE at ₹0"
                    android:fontFamily="@font/roboto_bold"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="#e8f5e9"
                    android:id="@+id/tvPromoSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Special Welcome Offer • Free on your 1st ride"
                    android:fontFamily="@font/roboto"/>
            </LinearLayout>
            <TextView
                android:textSize="11sp"
                android:textColor="#1b6a20"
                android:id="@+id/tvPromoOfferBadge"
                android:background="@drawable/rounded_border_background"
                android:paddingLeft="10dp"
                android:paddingTop="5dp"
                android:paddingRight="10dp"
                android:paddingBottom="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1st Ride @ ₹0"
                android:layout_centerVertical="true"
                android:fontFamily="@font/roboto_bold"
                android:layout_alignParentEnd="true"
                android:backgroundTint="@color/white"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"/>
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>
    <ProgressBar
        android:id="@+id/pbLoading"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/green"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardPromoBanner"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#64748b"
        android:id="@+id/tvRoutesCount"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="16dp"
        android:fontFamily="@font/roboto_medium"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@+id/cardPromoBanner"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRoutes"
        android:paddingTop="6dp"
        android:paddingBottom="24dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvRoutesCount"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/emptyState"
        android:padding="24dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardPromoBanner">
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_shuttle_bus"
            app:tint="#94a3b8"/>
        <TextView
            android:textSize="18sp"
            android:textColor="#1e293b"
            android:id="@+id/tvEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="No routes available"
            android:fontFamily="@font/roboto_bold"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#64748b"
            android:gravity="center"
            android:id="@+id/tvEmptyMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="No direct shuttle routes found between these locations on this date."/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
