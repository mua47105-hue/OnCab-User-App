<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#eaf5f1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/headerLayout"
                android:paddingTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/ivBack"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/back"
                    android:layout_marginStart="16dp"
                    app:layout_constraintBottom_toBottomOf="@+id/llTitleGroup"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/llTitleGroup"
                    app:tint="#0e6047"/>
                <ImageView
                    android:id="@+id/ivShuttleLogo"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/shuttle_bus"
                    android:layout_marginStart="10dp"
                    app:layout_constraintBottom_toBottomOf="@+id/llTitleGroup"
                    app:layout_constraintStart_toEndOf="@+id/ivBack"
                    app:layout_constraintTop_toTopOf="@+id/llTitleGroup"
                    app:tint="#0e6047"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/llTitleGroup"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    app:layout_constraintEnd_toStartOf="@+id/tvWalletSummary"
                    app:layout_constraintStart_toEndOf="@+id/ivShuttleLogo"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:textSize="22sp"
                        android:textColor="#0e6047"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Oncab"
                        android:fontFamily="@font/roboto_bold"/>
                    <TextView
                        android:textSize="10sp"
                        android:textColor="#52796f"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Safe  •  Comfortable  •  On Time"
                        android:fontFamily="@font/roboto"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/llHeaderActions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="10dp"
                    app:layout_constraintBottom_toBottomOf="@+id/llTitleGroup"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/llTitleGroup">
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cvWalletSummary"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        app:cardBackgroundColor="@color/adaptive_surface"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="1dp"
                        app:strokeWidth="0dp">
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingLeft="8dp"
                            android:paddingRight="8dp"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:paddingHorizontal="8dp">
                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:src="@drawable/wallet"
                                app:tint="@color/adaptive_on_surface"/>
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/adaptive_on_surface"
                                android:id="@+id/tvWalletSummary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Wallet ₹0"
                                android:fontFamily="@font/roboto_bold"
                                android:layout_marginStart="6dp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
                <ImageView
                    android:id="@+id/ivBusBannerHeader"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_marginTop="10dp"
                    android:src="@drawable/busimage"
                    android:scaleType="fitXY"
                    app:layout_constraintTop_toBottomOf="@+id/llTitleGroup"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:orientation="vertical"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:paddingBottom="24dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="18dp">
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="#ddf0e9"
                    app:cardCornerRadius="26dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:padding="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:id="@+id/tvOneWay"
                            android:background="@drawable/button_background"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="One Way"
                            android:layout_weight="1"
                            android:fontFamily="@font/roboto_bold"
                            android:backgroundTint="#0e6047"
                            android:paddingVertical="12dp"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#0e6047"
                            android:gravity="center"
                            android:id="@+id/tvRoundTrip"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Round Trip"
                            android:layout_weight="1"
                            android:fontFamily="@font/roboto_bold"
                            android:paddingVertical="12dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#e2efea"
                    app:strokeWidth="1dp">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:paddingLeft="16dp"
                        android:paddingTop="16dp"
                        android:paddingRight="16dp"
                        android:paddingBottom="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="16dp">
                        <ImageView
                            android:id="@+id/ivFromIcon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_baseline_location_on_24"
                            app:layout_constraintBottom_toBottomOf="@+id/llFromText"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="@+id/llFromText"
                            app:tint="#0e6047"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/llFromText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            app:layout_constraintEnd_toStartOf="@+id/ivClearFrom"
                            app:layout_constraintStart_toEndOf="@+id/ivFromIcon"
                            app:layout_constraintTop_toTopOf="parent">
                            <TextView
                                android:textSize="12sp"
                                android:textColor="#829590"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="From"
                                android:fontFamily="@font/roboto"/>
                            <EditText
                                android:textSize="16sp"
                                android:textColor="#111827"
                                android:id="@+id/etFrom"
                                android:background="@null"
                                android:paddingTop="4dp"
                                android:paddingBottom="4dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text=""
                                android:hint="Select Origin"
                                android:inputType="text"
                                android:fontFamily="@font/roboto_bold"
                                android:paddingVertical="4dp"/>
                        </LinearLayout>
                        <ImageView
                            android:id="@+id/ivClearFrom"
                            android:padding="3dp"
                            android:visibility="gone"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_baseline_close_24"
                            android:layout_marginEnd="8dp"
                            app:layout_constraintBottom_toBottomOf="@+id/llFromText"
                            app:layout_constraintEnd_toStartOf="@+id/ivExchange"
                            app:layout_constraintTop_toTopOf="@+id/llFromText"
                            app:tint="#888888"/>
                        <View
                            android:id="@+id/divider"
                            android:background="#e8f1ed"
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_marginTop="12dp"
                            app:layout_constraintEnd_toStartOf="@+id/ivExchange"
                            app:layout_constraintStart_toStartOf="@+id/llFromText"
                            app:layout_constraintTop_toBottomOf="@+id/llFromText"/>
                        <ImageView
                            android:id="@+id/ivToIcon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/location"
                            app:layout_constraintBottom_toBottomOf="@+id/llToText"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="@+id/llToText"
                            app:tint="#e53935"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/llToText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:layout_marginStart="14dp"
                            app:layout_constraintEnd_toStartOf="@+id/ivClearTo"
                            app:layout_constraintStart_toEndOf="@+id/ivToIcon"
                            app:layout_constraintTop_toBottomOf="@+id/divider">
                            <TextView
                                android:textSize="12sp"
                                android:textColor="#829590"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="To"
                                android:fontFamily="@font/roboto"/>
                            <EditText
                                android:textSize="16sp"
                                android:textColor="#111827"
                                android:id="@+id/etTo"
                                android:background="@null"
                                android:paddingTop="4dp"
                                android:paddingBottom="4dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text=""
                                android:hint="Select Destination"
                                android:inputType="text"
                                android:fontFamily="@font/roboto_bold"
                                android:paddingVertical="4dp"/>
                        </LinearLayout>
                        <ImageView
                            android:id="@+id/ivClearTo"
                            android:padding="3dp"
                            android:visibility="gone"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_baseline_close_24"
                            android:layout_marginEnd="8dp"
                            app:layout_constraintBottom_toBottomOf="@+id/llToText"
                            app:layout_constraintEnd_toStartOf="@+id/ivExchange"
                            app:layout_constraintTop_toTopOf="@+id/llToText"
                            app:tint="#888888"/>
                        <FrameLayout
                            android:id="@+id/ivExchange"
                            android:background="@drawable/rounded_border_background"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:backgroundTint="#e0f2ec"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent">
                            <ImageView
                                android:layout_gravity="center"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_baseline_swap_vertical_circle_24"
                                app:tint="#0e6047"/>
                        </FrameLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSuggestions"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="3dp"
                    app:strokeColor="#e0e0e0"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:orientation="vertical"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="8dp">
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingLeft="14dp"
                            android:paddingTop="6dp"
                            android:paddingRight="14dp"
                            android:paddingBottom="6dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="6dp">
                            <TextView
                                android:textSize="11sp"
                                android:textColor="#888888"
                                android:id="@+id/tvSuggestionsHeader"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="BUS STOPS &amp; PLACES"
                                android:layout_weight="1"
                                android:fontFamily="@font/roboto_bold"/>
                            <ProgressBar
                                android:id="@+id/pbSuggestions"
                                android:visibility="gone"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                style="?android:attr/progressBarStyleSmall"/>
                        </LinearLayout>
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvSearchSuggestions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                        <TextView
                            android:textSize="13sp"
                            android:textColor="#888888"
                            android:gravity="center"
                            android:id="@+id/tvNoSuggestions"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="No matching stops or places found."
                            android:paddingVertical="16dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.button.MaterialButton
                    android:textSize="12sp"
                    android:textColor="@android:color/white"
                    android:id="@+id/btnSearch"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="15dp"
                    android:text="Search Shuttle"
                    android:textAllCaps="false"
                    android:fontFamily="@font/roboto_bold"
                    app:backgroundTint="#0e6047"
                    app:cornerRadius="18dp"
                    app:icon="@drawable/ic_baseline_search_24"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconSize="24dp"
                    app:iconTint="@android:color/white"
                    app:strokeWidth="0dp"/>
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/vpBanners"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="32dp"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
