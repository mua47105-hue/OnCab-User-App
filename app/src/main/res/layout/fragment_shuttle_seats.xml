<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#eaf5f1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/back"
                app:tint="@color/black"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select Seats"
                    android:fontFamily="@font/roboto_bold"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/grey"
                    android:id="@+id/tvTripSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Garia -&gt; Bidhannagar | 02:12 PM"
                    android:fontFamily="@font/roboto"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardBusInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="16dp"
        android:layout_marginHorizontal="16dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="12dp"
        app:cardElevation="1dp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:strokeColor="#e0e0e0"
        app:strokeWidth="1dp">
        <LinearLayout
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/black"
                android:id="@+id/tvBusType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deluxe Bus 40-Seater • SCH-2026-8537"
                android:fontFamily="@font/roboto_bold"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#2e7d32"
                android:id="@+id/tvSeatsBadgeInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="24 Available • 0 Booked • 24 Total"
                android:fontFamily="@font/roboto"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/legendLayout"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="12dp"
        app:layout_constraintTop_toBottomOf="@+id/cardBusInfo">
        <View
            android:background="@drawable/round_corner"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:backgroundTint="#4caf50"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Available"
            android:fontFamily="@font/roboto_medium"
            android:layout_marginStart="6dp"/>
        <View
            android:background="@drawable/round_corner"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="16dp"
            android:backgroundTint="#bdbdbd"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Booked"
            android:fontFamily="@font/roboto_medium"
            android:layout_marginStart="6dp"/>
        <View
            android:background="@drawable/round_corner"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="16dp"
            android:backgroundTint="#1e88e5"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selected"
            android:fontFamily="@font/roboto_medium"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/busLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="24dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomLayout"
        app:layout_constraintTop_toBottomOf="@+id/legendLayout"
        app:strokeColor="#e0e0e0"
        app:strokeWidth="1dp">
        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:paddingBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/grey"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FRONT / DOOR"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/roboto_medium"
                    android:layout_alignParentStart="true"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true">
                    <TextView
                        android:textSize="10sp"
                        android:textColor="@color/grey"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DRIVER"
                        android:fontFamily="@font/roboto_medium"
                        android:layout_marginEnd="6dp"/>
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/driver_icon"
                        app:tint="@color/grey"/>
                </LinearLayout>
            </RelativeLayout>
            <View
                android:background="#eeeeee"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="12dp"/>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSeats"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:overScrollMode="never"/>
                <ProgressBar
                    android:layout_gravity="center"
                    android:id="@+id/pbSeatsLoading"
                    android:visibility="visible"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:indeterminateTint="#0e6047"/>
            </FrameLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/bottomLayout"
        android:background="@color/white"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/grey"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Selected Seats"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:id="@+id/tvSelectedSeats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="None"
                    android:fontFamily="@font/roboto_bold"/>
            </LinearLayout>
            <TextView
                android:textSize="20sp"
                android:textColor="@color/black"
                android:id="@+id/tvTotalPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹ 1 / seat"
                android:layout_centerVertical="true"
                android:fontFamily="@font/roboto_bold"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="16sp"
            android:textColor="@color/white"
            android:id="@+id/btnContinue"
            android:background="@drawable/button_background"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:text="Continue"
            android:textAllCaps="false"
            android:fontFamily="@font/roboto_bold"
            android:backgroundTint="#0e6047"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
