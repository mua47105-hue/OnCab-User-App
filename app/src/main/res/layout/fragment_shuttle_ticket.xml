<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#eaf5f1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/back"
            app:tint="@color/black"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/black"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Booking Confirmed"
            android:fontFamily="@font/roboto_bold"/>
    </androidx.appcompat.widget.Toolbar>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/actionsLayout"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/tickimg"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_baseline_check_circle_24"
                app:tint="@color/green"/>
            <TextView
                android:textSize="18sp"
                android:textColor="@color/green"
                android:id="@+id/txtsuccess"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Your Shuttle Ticket is Booked!"
                android:fontFamily="@font/roboto_bold"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/grey"
                android:gravity="center"
                android:id="@+id/changed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Keep this QR code or PIN ready\10at the boarding stop."/>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="#f8f9fa"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#e0e0e0"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="10sp"
                        android:textColor="#f39101"
                        android:background="@drawable/rounded_border_background"
                        android:paddingLeft="8dp"
                        android:paddingTop="2dp"
                        android:paddingRight="8dp"
                        android:paddingBottom="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AC Shuttle"
                        android:textAlignment="textStart"
                        android:layout_alignParentEnd="true"
                        android:backgroundTint="#fff8e1"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"/>
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/black"
                            android:id="@+id/tvRoute"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kolkata -&gt; Airport"
                            android:fontFamily="@font/roboto_bold"/>
                    </RelativeLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/grey"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Departure"/>
                            <TextView
                                android:textSize="16sp"
                                android:textColor="@color/black"
                                android:id="@+id/tvDepartureTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="08:30 AM"
                                android:fontFamily="@font/roboto_bold"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="end"
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/grey"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Arrival"/>
                            <TextView
                                android:textSize="16sp"
                                android:textColor="@color/black"
                                android:id="@+id/tvArrivalTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="09:45 AM"
                                android:fontFamily="@font/roboto_bold"/>
                        </LinearLayout>
                    </LinearLayout>
                    <View
                        android:background="#e0e0e0"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/grey"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Seat Numbers"/>
                            <TextView
                                android:textSize="16sp"
                                android:textColor="@color/black"
                                android:id="@+id/tvSeats"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="A4, A5"
                                android:fontFamily="@font/roboto_bold"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="end"
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/grey"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Booking ID"/>
                            <TextView
                                android:textSize="16sp"
                                android:textColor="@color/black"
                                android:id="@+id/tvBookingId"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="OC10245"
                                android:fontFamily="@font/roboto_bold"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:background="#ffffff"
                        android:padding="14dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp">
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/grey"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bus &amp; Driver Details"
                            android:fontFamily="@font/roboto_bold"/>
                        <TextView
                            android:textSize="15sp"
                            android:textColor="#0e6047"
                            android:id="@+id/tvBusNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Bus No: Not assigned"
                            android:fontFamily="@font/roboto_bold"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/black"
                            android:id="@+id/tvDriverName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Driver: Not assigned"
                            android:fontFamily="@font/roboto_medium"/>
                        <TextView
                            android:textSize="13sp"
                            android:textColor="#0f172a"
                            android:id="@+id/tvDriverMobile"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Phone: --"/>
                    </LinearLayout>
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/ivQrCode"
                        android:layout_width="160dp"
                        android:layout_height="160dp"
                        android:layout_marginTop="24dp"
                        android:src="@drawable/qr"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/grey"
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="PIN"/>
                    <TextView
                        android:textSize="24sp"
                        android:textColor="@color/black"
                        android:layout_gravity="center"
                        android:id="@+id/tvPin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="4821"
                        android:fontFamily="@font/roboto_bold"
                        android:letterSpacing="0.2"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/actionsLayout"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatButton
                android:textSize="15sp"
                android:textColor="@color/black"
                android:id="@+id/btnViewBooking"
                android:background="@drawable/button_bg_outline"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:text="View Booking"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:fontFamily="@font/roboto_bold"
                android:layout_marginEnd="8dp"/>
            <androidx.appcompat.widget.AppCompatButton
                android:textSize="15sp"
                android:textColor="@color/white"
                android:id="@+id/btnTrackBus"
                android:background="@drawable/button_background"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:text="Track Bus"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:fontFamily="@font/roboto_bold"
                android:layout_marginStart="8dp"
                android:backgroundTint="#0e6047"/>
        </LinearLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="#d32f2f"
            android:layout_gravity="center"
            android:id="@+id/btnCancelTicket"
            android:background="?attr/selectableItemBackground"
            android:paddingLeft="16dp"
            android:paddingTop="6dp"
            android:paddingRight="16dp"
            android:paddingBottom="6dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Cancel Booking"
            android:fontFamily="@font/roboto_medium"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
