<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#eaf5f1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <fragment
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:id="@+id/shuttleMap"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@android:color/transparent"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:paddingHorizontal="16dp"
        app:layout_anchorGravity="top">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/ivBack"
                android:background="@drawable/circle_pulse"
                android:padding="8dp"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/back"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                android:elevation="6dp"
                android:backgroundTint="@color/white"
                app:tint="@color/black"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:id="@+id/llLiveStatusBadge"
                android:background="@drawable/bg_live_pulse_badge"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_centerInParent="true"
                android:elevation="6dp"
                android:paddingHorizontal="14dp">
                <View
                    android:id="@+id/vLivePulseDot"
                    android:background="@drawable/circle1"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:backgroundTint="#16a34a"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#15803d"
                    android:id="@+id/tvLiveStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LIVE TRACKING"
                    android:fontFamily="@font/roboto_bold"
                    android:layout_marginStart="7dp"/>
            </LinearLayout>
        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvNextStop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="68dp"
        android:layout_marginRight="16dp"
        android:layout_marginHorizontal="16dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="14dp"
        app:cardElevation="6dp"
        app:strokeColor="#e2e8f0"
        app:strokeWidth="1dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="14dp"
            android:paddingTop="10dp"
            android:paddingRight="14dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">
            <FrameLayout
                android:background="@drawable/circle1"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:backgroundTint="#fef3c7">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/ivHeaderVehicleIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_shuttle_bus"
                    app:tint="#d97706"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp">
                <TextView
                    android:textSize="10sp"
                    android:textColor="#d97706"
                    android:id="@+id/tvNextStopLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PICKUP STOP"
                    android:fontFamily="@font/roboto_bold"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="#0f172a"
                    android:ellipsize="end"
                    android:id="@+id/tvNextStopName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Park Street (Boarding)"
                    android:maxLines="1"
                    android:fontFamily="@font/roboto_bold"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#059669"
                    android:id="@+id/tvNextStopEta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="2.4 km • 7 mins away"
                    android:fontFamily="@font/roboto_medium"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/ivRecenterQuick"
                android:background="@drawable/circle1"
                android:padding="8dp"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_baseline_my_location_24"
                android:backgroundTint="#f8fafc"
                app:tint="#475569"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="end|bottom"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="260dp"
        android:layout_marginEnd="16dp">
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabFitRoute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:contentDescription="Fit full route"
            app:backgroundTint="@color/white"
            app:elevation="6dp"
            app:fabCustomSize="46dp"
            app:srcCompat="@drawable/ic_route_fit"
            app:tint="#334155"/>
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabFocusBus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Focus on live bus"
            app:backgroundTint="#1e293b"
            app:elevation="6dp"
            app:fabCustomSize="48dp"
            app:srcCompat="@drawable/ic_shuttle_bus"
            app:tint="@color/white"/>
    </LinearLayout>
    <include
        android:id="@+id/shuttleTrackingBottomSheet"
        layout="@layout/shuttle_tracking_bottom_sheet"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
