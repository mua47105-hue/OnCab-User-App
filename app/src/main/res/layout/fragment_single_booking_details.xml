<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#f8f9fa"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerLayout"
        android:background="@color/black"
        android:paddingLeft="16dp"
        android:paddingTop="14dp"
        android:paddingRight="16dp"
        android:paddingBottom="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/backBtn"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/white"
            android:id="@+id/orderDateTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Order ID: 000000"
            android:fontFamily="@font/roboto_bold"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toStartOf="@+id/llPins"
            app:layout_constraintStart_toEndOf="@+id/backBtn"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/grey"
            android:id="@+id/orderID"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Date, Time"
            android:fontFamily="@font/roboto"
            app:layout_constraintStart_toStartOf="@+id/orderDateTime"
            app:layout_constraintTop_toBottomOf="@+id/orderDateTime"/>
        <LinearLayout
            android:gravity="end"
            android:orientation="vertical"
            android:id="@+id/llPins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/white"
                android:id="@+id/tvStartPin"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start Pin: 0000"
                android:fontFamily="@font/roboto_bold"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/white"
                android:id="@+id/tvEndPin"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="End Pin: 0000"
                android:fontFamily="@font/roboto_bold"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerLayout">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/shareContainer"
            android:background="#f8f9fa"
            android:paddingBottom="40dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutShareHeader"
                android:background="@color/black"
                android:paddingLeft="20dp"
                android:paddingTop="14dp"
                android:paddingRight="20dp"
                android:paddingBottom="14dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingVertical="14dp"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/white"
                    android:id="@+id/tvShareOrderId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Order ID: 000000"
                    android:fontFamily="@font/roboto_bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#bbbbbb"
                    android:id="@+id/tvShareDateTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Date, Time"
                    android:fontFamily="@font/roboto"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvShareOrderId"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <FrameLayout
                android:id="@+id/mapWrapper"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                app:layout_constraintTop_toBottomOf="@+id/layoutShareHeader">
                <fragment
                    android:name="com.google.android.gms.maps.SupportMapFragment"
                    android:id="@+id/orderMap"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvDistance"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                app:cardBackgroundColor="@color/black"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:id="@+id/tvDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginRight="12dp"
                    android:layout_marginBottom="6dp"
                    android:text="0.0 km"
                    android:fontFamily="@font/roboto_medium"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginVertical="6dp"/>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/summaryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="12dp"
                android:layout_marginHorizontal="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:layout_constraintTop_toBottomOf="@+id/mapWrapper">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:padding="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/driverProfilePic"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/profile"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="18sp"
                        android:textColor="@color/black"
                        android:id="@+id/tvDriverName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Driver"
                        android:fontFamily="@font/roboto_bold"
                        android:layout_marginEnd="12dp"
                        app:layout_constraintEnd_toStartOf="@+id/driverProfilePic"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/driverProfilePic"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/grey"
                        android:id="@+id/tvVehicleNumber"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Vehicle Info"
                        android:fontFamily="@font/roboto_medium"
                        app:layout_constraintEnd_toEndOf="@+id/tvDriverName"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvDriverName"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        android:id="@+id/tvPassengerName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Passenger: Name"
                        android:fontFamily="@font/roboto"
                        app:layout_constraintEnd_toEndOf="@+id/tvDriverName"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvVehicleNumber"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/grey"
                        android:id="@+id/tvOrderedBy"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Ordered by: Name"
                        android:fontFamily="@font/roboto"
                        app:layout_constraintEnd_toEndOf="@+id/tvDriverName"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvPassengerName"/>
                    <View
                        android:id="@+id/divider1"
                        android:background="@color/lightGray"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        app:layout_constraintTop_toBottomOf="@+id/tvOrderedBy"
                        app:layout_goneMarginTop="16dp"/>
                    <ImageView
                        android:id="@+id/carImage"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginTop="16dp"
                        android:src="@drawable/ic_car_type"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/divider1"/>
                    <TextView
                        android:textSize="18sp"
                        android:textColor="@color/black"
                        android:id="@+id/carName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vehicle"
                        android:fontFamily="@font/roboto_bold"
                        android:layout_marginStart="16dp"
                        app:layout_constraintStart_toEndOf="@+id/carImage"
                        app:layout_constraintTop_toTopOf="@+id/carImage"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/grey"
                        android:id="@+id/rideStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Delivered • Daily"
                        android:fontFamily="@font/roboto_bold"
                        app:layout_constraintStart_toStartOf="@+id/carName"
                        app:layout_constraintTop_toBottomOf="@+id/carName"/>
                    <androidx.appcompat.widget.AppCompatRatingBar
                        android:id="@+id/rating"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="?android:attr/ratingBarStyleSmall"/>
                    <TextView
                        android:id="@+id/tvYouRated"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:id="@+id/tvRentalPriceTop"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/routeCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="12dp"
                android:layout_marginRight="12dp"
                android:layout_marginHorizontal="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:layout_constraintTop_toBottomOf="@+id/summaryCard">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:padding="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/green"
                        android:id="@+id/sTime"
                        android:layout_width="70dp"
                        android:layout_height="wrap_content"
                        android:text="Pickup"
                        android:fontFamily="@font/roboto_bold"
                        app:layout_constraintBaseline_toBaselineOf="@+id/sourceLocation"
                        app:layout_constraintStart_toStartOf="parent"/>
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/black"
                        android:ellipsize="end"
                        android:id="@+id/sourceLocation"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Pickup Address"
                        android:maxLines="2"
                        android:fontFamily="@font/roboto"
                        android:layout_marginStart="12dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/sTime"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/grey"
                        android:id="@+id/stopLabel"
                        android:visibility="gone"
                        android:layout_width="70dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="Stop"
                        android:fontFamily="@font/roboto_bold"
                        app:layout_constraintBaseline_toBaselineOf="@+id/tvStoppage"
                        app:layout_constraintStart_toStartOf="parent"/>
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/black"
                        android:ellipsize="end"
                        android:id="@+id/tvStoppage"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Stoppage Address"
                        android:maxLines="2"
                        android:fontFamily="@font/roboto"
                        android:layout_marginStart="12dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/stopLabel"
                        app:layout_constraintTop_toBottomOf="@+id/sourceLocation"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/red"
                        android:id="@+id/dTime"
                        android:layout_width="70dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="Drop Off"
                        android:fontFamily="@font/roboto_bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvStoppage"
                        app:layout_goneMarginTop="24dp"/>
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/black"
                        android:ellipsize="end"
                        android:id="@+id/destinationLocation"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Drop Address"
                        android:maxLines="2"
                        android:fontFamily="@font/roboto"
                        android:layout_marginStart="12dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/dTime"
                        app:layout_constraintTop_toTopOf="@+id/dTime"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/billCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="12dp"
                android:layout_marginRight="12dp"
                android:layout_marginHorizontal="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:layout_constraintTop_toBottomOf="@+id/routeCard">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:padding="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="18sp"
                        android:textColor="@color/black"
                        android:id="@+id/billTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bill Details"
                        android:fontFamily="@font/roboto_bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/grey"
                        android:id="@+id/tripLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Your Trip"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/billTitle"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:id="@+id/tripPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹0"
                        app:layout_constraintBottom_toBottomOf="@+id/tripLabel"
                        app:layout_constraintEnd_toEndOf="parent"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/grey"
                        android:id="@+id/wFeeLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Waiting Fees"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tripLabel"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:id="@+id/wFeePrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹0"
                        app:layout_constraintBottom_toBottomOf="@+id/wFeeLabel"
                        app:layout_constraintEnd_toEndOf="parent"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/grey"
                        android:id="@+id/roundOffLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Rounded Off"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/wFeeLabel"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:id="@+id/roundOffPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹0"
                        app:layout_constraintBottom_toBottomOf="@+id/roundOffLabel"
                        app:layout_constraintEnd_toEndOf="parent"/>
                    <View
                        android:id="@+id/divider2"
                        android:background="@color/grey"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        app:layout_constraintTop_toBottomOf="@+id/roundOffLabel"/>
                    <TextView
                        android:textSize="18sp"
                        android:textColor="@color/black"
                        android:id="@+id/totalLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Total Payable"
                        android:fontFamily="@font/roboto_bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/divider2"/>
                    <TextView
                        android:textSize="18sp"
                        android:textColor="@color/black"
                        android:id="@+id/totalPayableAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹0"
                        android:fontFamily="@font/roboto_bold"
                        app:layout_constraintBottom_toBottomOf="@+id/totalLabel"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/totalLabel"/>
                    <View
                        android:id="@+id/dividerBillBottom"
                        android:background="@color/lightGray"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        app:layout_constraintTop_toBottomOf="@+id/totalLabel"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/grey"
                        android:id="@+id/paymentModeLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Payment Mode"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/dividerBillBottom"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        android:id="@+id/tvPaymentMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cash"
                        android:fontFamily="@font/roboto_medium"
                        app:layout_constraintBottom_toBottomOf="@+id/paymentModeLabel"
                        app:layout_constraintEnd_toEndOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/layoutTrademark"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/billCard">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@mipmap/ic_logo_new"/>
                <TextView
                    android:textSize="22sp"
                    android:textColor="@color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OnCab"
                    android:fontFamily="@font/roboto_bold"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="end"
                android:orientation="horizontal"
                android:id="@+id/actionsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:baselineAligned="false"
                android:paddingEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/billCard">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/layoutCouponApplied"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_width="1dp"
                        android:layout_height="1dp"
                        android:src="@drawable/coupon_02"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/shareBtn"
                    android:background="?attr/selectableItemBackground"
                    android:paddingLeft="12dp"
                    android:paddingTop="8dp"
                    android:paddingRight="12dp"
                    android:paddingBottom="8dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SHARE"
                        android:fontFamily="@font/roboto_medium"/>
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_baseline_share_24"
                        android:layout_marginStart="8dp"
                        app:tint="@color/black"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/support"
                    android:background="?attr/selectableItemBackground"
                    android:paddingLeft="12dp"
                    android:paddingTop="8dp"
                    android:paddingRight="12dp"
                    android:paddingBottom="8dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SUPPORT"
                        android:fontFamily="@font/roboto_medium"/>
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_baseline_call_24"
                        android:layout_marginStart="8dp"
                        app:tint="@color/black"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
