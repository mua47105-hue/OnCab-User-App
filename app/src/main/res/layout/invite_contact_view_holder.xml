<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/contactProfilePic"
            android:background="@drawable/profile"
            android:layout_width="60dp"
            android:layout_height="60dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="16sp"
            android:textColor="?attr/colorOnSurface"
            android:id="@+id/contactName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Harry TCS"
            android:fontFamily="@font/roboto_medium"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toStartOf="@+id/invite"
            app:layout_constraintStart_toEndOf="@+id/contactProfilePic"
            app:layout_constraintTop_toTopOf="@+id/contactProfilePic"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/grey"
            android:id="@+id/contactNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="87682902008"
            android:fontFamily="@font/roboto"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toStartOf="@+id/invite"
            app:layout_constraintStart_toStartOf="@+id/contactName"
            app:layout_constraintTop_toBottomOf="@+id/contactName"/>
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="14sp"
            android:textColor="@color/button_text"
            android:id="@+id/invite"
            android:background="@drawable/button_background01"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:text="+ Invite"
            android:textAllCaps="false"
            android:fontFamily="@font/roboto"
            android:backgroundTint="@color/cyne"
            android:paddingHorizontal="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/contactProfilePic"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/contactProfilePic"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
