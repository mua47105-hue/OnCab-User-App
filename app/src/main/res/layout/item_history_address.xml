<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/selectableItemBackground"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="16dp"
    android:paddingVertical="12dp">
    <ImageView
        android:id="@+id/ivHistory"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="2dp"
        android:src="@drawable/baseline_history_24"
        app:layout_constraintBottom_toBottomOf="@+id/tvHistoryMain"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvHistoryMain"
        app:tint="?attr/colorOnSurfaceVariant"/>
    <TextView
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:id="@+id/tvDistance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/roboto"
        app:layout_constraintEnd_toEndOf="@+id/ivHistory"
        app:layout_constraintStart_toStartOf="@+id/ivHistory"
        app:layout_constraintTop_toBottomOf="@+id/ivHistory"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:ellipsize="end"
        android:id="@+id/tvHistoryMain"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:fontFamily="@font/roboto"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/ivFavorite"
        app:layout_constraintStart_toEndOf="@+id/ivHistory"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:ellipsize="end"
        android:id="@+id/tvHistorySub"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:fontFamily="@font/roboto"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/ivFavorite"
        app:layout_constraintStart_toStartOf="@+id/tvHistoryMain"
        app:layout_constraintTop_toBottomOf="@+id/tvHistoryMain"/>
    <ImageView
        android:id="@+id/ivFavorite"
        android:padding="6dp"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_star"
        app:layout_constraintBottom_toBottomOf="@+id/tvHistorySub"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvHistoryMain"
        app:tint="?attr/colorOnSurfaceVariant"/>
    <View
        android:id="@+id/vDivider"
        android:background="@drawable/dashed_line"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layerType="software"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tvHistoryMain"
        app:layout_constraintTop_toBottomOf="@+id/tvHistorySub"/>
</androidx.constraintlayout.widget.ConstraintLayout>
