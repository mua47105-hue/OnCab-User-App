<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardRouteRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="12dp"
    android:layout_marginTop="8dp"
    android:layout_marginRight="12dp"
    android:layout_marginBottom="8dp"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="#e2e8f0"
    app:strokeWidth="1dp">
    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_toStartOf="@+id/tvNearestBadge">
                <TextView
                    android:textSize="16sp"
                    android:textColor="#0f172a"
                    android:ellipsize="end"
                    android:id="@+id/tvRouteName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:fontFamily="@font/roboto_bold"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">
                    <TextView
                        android:textSize="11sp"
                        android:textColor="#475569"
                        android:id="@+id/tvRouteCodeLabel"
                        android:background="@drawable/bg_badge_route_code"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_medium"/>
                    <TextView
                        android:textSize="10sp"
                        android:textColor="#2e8b32"
                        android:id="@+id/tvTopPickBadge"
                        android:background="@drawable/bg_badge_top_pick"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="★ Top Pick"
                        android:fontFamily="@font/roboto_bold"
                        android:layout_marginStart="0dp"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:textSize="11sp"
                android:textColor="#2e8b32"
                android:id="@+id/tvNearestBadge"
                android:background="@drawable/bg_nearest_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nearest"
                android:layout_alignParentTop="true"
                android:fontFamily="@font/roboto_medium"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <View
            android:background="#f1f5f9"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <LinearLayout
                android:gravity="top"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="12sp"
                    android:textColor="#1e293b"
                    android:gravity="center"
                    android:id="@+id/tvPickupTime"
                    android:background="@drawable/bg_time_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="68dp"
                    android:fontFamily="@font/roboto_bold"/>
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginRight="8dp"
                    android:src="@drawable/timeline_dot_origin"
                    android:layout_marginHorizontal="8dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="#0f172a"
                        android:ellipsize="end"
                        android:id="@+id/tvPickupStopName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:fontFamily="@font/roboto_bold"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#64748b"
                        android:ellipsize="end"
                        android:id="@+id/tvPickupAddress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:maxLines="1"
                        android:fontFamily="@font/roboto"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/llPickupTravelMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp">
                        <ImageView
                            android:id="@+id/ivPickupTravelIcon"
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:src="@drawable/ic_walk_person"
                            app:tint="#64748b"/>
                        <TextView
                            android:textSize="11sp"
                            android:textColor="#64748b"
                            android:id="@+id/tvPickupDistance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto"
                            android:layout_marginStart="4dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/llMiddleStopsToggle"
                    android:background="?attr/selectableItemBackground"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="4dp">
                    <View
                        android:background="#cbd5e1"
                        android:layout_width="1.5dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="84dp"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#3b82f6"
                        android:id="@+id/tvMiddleStopsCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_medium"
                        android:layout_marginStart="16dp"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/llMiddleStoppagesList"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="top"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="12sp"
                    android:textColor="#1e293b"
                    android:gravity="center"
                    android:id="@+id/tvDropTime"
                    android:background="@drawable/bg_time_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="68dp"
                    android:fontFamily="@font/roboto_bold"/>
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginRight="8dp"
                    android:src="@drawable/timeline_dot_dest"
                    android:layout_marginHorizontal="8dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="#0f172a"
                        android:ellipsize="end"
                        android:id="@+id/tvDropStopName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:fontFamily="@font/roboto_bold"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#64748b"
                        android:ellipsize="end"
                        android:id="@+id/tvDropAddress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:maxLines="1"
                        android:fontFamily="@font/roboto"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/llDropTravelMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp">
                        <ImageView
                            android:id="@+id/ivDropTravelIcon"
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:src="@drawable/ic_walk_person"
                            app:tint="#64748b"/>
                        <TextView
                            android:textSize="11sp"
                            android:textColor="#64748b"
                            android:id="@+id/tvDropDistance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto"
                            android:layout_marginStart="4dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#f8fafc"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="#edf2f7"
            app:strokeWidth="1dp">
            <LinearLayout
                android:orientation="vertical"
                android:padding="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.recyclerview.widget.RecyclerView
                    android:orientation="horizontal"
                    android:id="@+id/rvTimings"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#94a3b8"
                    android:gravity="center"
                    android:id="@+id/tvNoTimings"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No upcoming schedules found for this date"
                    android:paddingVertical="10dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/llFareAndTimings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true">
                <LinearLayout
                    android:gravity="bottom"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="18sp"
                        android:textColor="#0f172a"
                        android:id="@+id/tvStartingFare"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_bold"/>
                    <TextView
                        android:textSize="11sp"
                        android:textColor="#64748b"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="/ seat"
                        android:fontFamily="@font/roboto"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/llViewAllTimings"
                    android:background="?attr/selectableItemBackground"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp">
                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:src="@drawable/ic_shuttle_bus"
                        app:tint="#2e8b32"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#2e8b32"
                        android:id="@+id/tvViewAllTimings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_medium"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatButton
                android:textSize="13sp"
                android:textColor="@color/white"
                android:id="@+id/btnProceed"
                android:background="@drawable/bg_pill_proceed_btn"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="120dp"
                android:text="Proceed ➔"
                android:layout_centerVertical="true"
                android:textAllCaps="false"
                android:fontFamily="@font/roboto_bold"
                android:layout_alignParentEnd="true"
                android:paddingHorizontal="20dp"/>
        </RelativeLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
