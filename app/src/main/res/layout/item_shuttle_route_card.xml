<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginRight="12dp"
    android:layout_marginBottom="6dp"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeColor="#eeeeee"
    app:strokeWidth="1dp">
    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@+id/tvRouteFare"
                android:layout_alignParentStart="true">
                <TextView
                    android:textSize="17sp"
                    android:textColor="@color/black"
                    android:id="@+id/tvRouteName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_bold"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#757575"
                    android:id="@+id/tvRouteCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/roboto"/>
            </LinearLayout>
            <TextView
                android:textSize="20sp"
                android:textColor="#3fa543"
                android:id="@+id/tvRouteFare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_bold"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <View
            android:background="#f0f0f0"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:layout_marginVertical="12dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_baseline_location_on_24"
                app:tint="@color/green"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#212121"
                android:ellipsize="end"
                android:id="@+id/tvPickupStop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_weight="1"
                android:fontFamily="@font/roboto_medium"
                android:layout_marginStart="8dp"/>
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp"
                android:src="@drawable/next"
                android:layout_marginHorizontal="6dp"
                app:tint="#9e9e9e"/>
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/location"
                app:tint="@color/red"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#212121"
                android:ellipsize="end"
                android:id="@+id/tvDropoffStop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_weight="1"
                android:fontFamily="@font/roboto_medium"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/btnSelectRoute"
                android:layout_alignParentStart="true">
                <TextView
                    android:textSize="12sp"
                    android:textColor="#424242"
                    android:id="@+id/tvDuration"
                    android:background="@drawable/rounded_border_background"
                    android:paddingLeft="8dp"
                    android:paddingTop="4dp"
                    android:paddingRight="8dp"
                    android:paddingBottom="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto"
                    android:backgroundTint="#f5f5f5"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#424242"
                    android:id="@+id/tvAvailableSeats"
                    android:background="@drawable/rounded_border_background"
                    android:paddingLeft="8dp"
                    android:paddingTop="4dp"
                    android:paddingRight="8dp"
                    android:paddingBottom="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#f5f5f5"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"/>
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatButton
                android:textSize="14sp"
                android:textColor="@color/white"
                android:id="@+id/btnSelectRoute"
                android:background="@drawable/button_background"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Select"
                android:layout_centerVertical="true"
                android:textAllCaps="false"
                android:fontFamily="@font/roboto_bold"
                android:layout_alignParentEnd="true"
                android:paddingHorizontal="20dp"/>
        </RelativeLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
