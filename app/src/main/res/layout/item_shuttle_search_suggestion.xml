<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/selectableItemBackground"
    android:paddingLeft="14dp"
    android:paddingTop="10dp"
    android:paddingRight="14dp"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp">
    <FrameLayout
        android:id="@+id/flIconBg"
        android:background="@drawable/circle_pulse"
        android:layout_width="34dp"
        android:layout_height="34dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/ivSuggestionIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_shuttle_bus"
            app:tint="@color/dark_blue"/>
    </FrameLayout>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/dark_blue"
        android:id="@+id/tvStopBadge"
        android:background="@drawable/bg_bus_stop_badge"
        android:paddingLeft="6dp"
        android:paddingTop="2dp"
        android:paddingRight="6dp"
        android:paddingBottom="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BUS STOP"
        android:fontFamily="@font/roboto_bold"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/flIconBg"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/black"
        android:ellipsize="end"
        android:id="@+id/tvSuggestionTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:fontFamily="@font/roboto_bold"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/tvStopBadge"
        app:layout_constraintStart_toEndOf="@+id/flIconBg"
        app:layout_constraintTop_toTopOf="@+id/flIconBg"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#666666"
        android:ellipsize="end"
        android:id="@+id/tvSuggestionSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:fontFamily="@font/roboto"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/flIconBg"
        app:layout_constraintTop_toBottomOf="@+id/tvSuggestionTitle"/>
    <View
        android:id="@+id/dividerSuggestion"
        android:background="#ededed"
        android:layout_width="0dp"
        android:layout_height="0.8dp"
        android:layout_marginTop="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tvSuggestionTitle"
        app:layout_constraintTop_toBottomOf="@+id/tvSuggestionSubtitle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
