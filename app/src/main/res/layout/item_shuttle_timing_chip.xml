<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/llChipRoot"
    android:background="@drawable/bg_timing_chip_unselected"
    android:paddingLeft="12dp"
    android:paddingTop="8dp"
    android:paddingRight="12dp"
    android:paddingBottom="8dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp"
    android:layout_marginEnd="8dp"
    android:layout_marginVertical="2dp"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llScheduleContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/llVehicleBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp">
            <ImageView
                android:id="@+id/ivVehicleIcon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_shuttle_bus"
                android:tint="#2e8b32"/>
            <TextView
                android:textSize="10sp"
                android:textColor="#2e8b32"
                android:id="@+id/tvVehicleType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <View
                android:background="@drawable/timeline_dot_origin"
                android:layout_width="6dp"
                android:layout_height="6dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#0f172a"
                android:id="@+id/tvChipPickupTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_bold"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
        <View
            android:background="#cbd5e1"
            android:layout_width="1.5dp"
            android:layout_height="5dp"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="1dp"
            android:layout_marginStart="2.25dp"
            android:layout_marginVertical="1dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <View
                android:background="@drawable/timeline_dot_dest"
                android:layout_width="6dp"
                android:layout_height="6dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#0f172a"
                android:id="@+id/tvChipDropTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_bold"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="#2e8b32"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tvMoreTimings"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:minWidth="54dp"
        android:minHeight="50dp"
        android:fontFamily="@font/roboto_bold"/>
</LinearLayout>
