<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/llStopItemRoot"
    android:background="?attr/selectableItemBackground"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="32dp"
        android:layout_height="match_parent">
        <View
            android:id="@+id/vTopLine"
            android:background="#cbd5e1"
            android:layout_width="2dp"
            android:layout_height="16dp"/>
        <FrameLayout
            android:id="@+id/flIndicator"
            android:layout_width="26dp"
            android:layout_height="26dp">
            <View
                android:layout_gravity="center"
                android:id="@+id/vIndicatorCircle"
                android:background="@drawable/circle1"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:backgroundTint="#475569"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/white"
                android:layout_gravity="center"
                android:id="@+id/tvIndicatorSeq"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_bold"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/ivIndicatorIcon"
                android:visibility="gone"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_baseline_check_circle_24"
                app:tint="@color/white"/>
        </FrameLayout>
        <View
            android:id="@+id/vBottomLine"
            android:background="#cbd5e1"
            android:layout_width="2dp"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:paddingVertical="12dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14sp"
                android:textColor="#0f172a"
                android:ellipsize="end"
                android:id="@+id/tvStopName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_weight="1"
                android:fontFamily="@font/roboto_bold"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#64748b"
                android:id="@+id/tvStopEta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp">
            <TextView
                android:textSize="10sp"
                android:textColor="#475569"
                android:id="@+id/tvStopBadge"
                android:background="@drawable/bg_badge_route_code"
                android:paddingLeft="6dp"
                android:paddingTop="1dp"
                android:paddingRight="6dp"
                android:paddingBottom="1dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stop 3"
                android:fontFamily="@font/roboto_bold"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"/>
            <TextView
                android:textSize="10sp"
                android:textColor="#059669"
                android:id="@+id/tvStopRoleBadge"
                android:background="@drawable/bg_badge_top_pick"
                android:paddingLeft="6dp"
                android:paddingTop="1dp"
                android:paddingRight="6dp"
                android:paddingBottom="1dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YOUR PICKUP"
                android:fontFamily="@font/roboto_bold"
                android:layout_marginStart="6dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"/>
            <TextView
                android:textSize="10sp"
                android:textColor="#d97706"
                android:id="@+id/tvBusHereBadge"
                android:background="@drawable/bg_live_pulse_badge"
                android:paddingLeft="6dp"
                android:paddingTop="1dp"
                android:paddingRight="6dp"
                android:paddingBottom="1dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="�� BUS IS HERE"
                android:fontFamily="@font/roboto_bold"
                android:layout_marginStart="6dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"/>
        </LinearLayout>
        <TextView
            android:textSize="11sp"
            android:textColor="#94a3b8"
            android:ellipsize="end"
            android:id="@+id/tvStopAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="1"
            android:fontFamily="@font/roboto"/>
    </LinearLayout>
</LinearLayout>
