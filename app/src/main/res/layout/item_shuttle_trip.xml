<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="#f0f0f0"
    app:strokeWidth="1dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/white"
            android:id="@+id/tvTopBadge"
            android:background="@drawable/rounded_green_bg"
            android:paddingLeft="8dp"
            android:paddingTop="4dp"
            android:paddingRight="8dp"
            android:paddingBottom="4dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Top pick for you"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/black"
            android:id="@+id/tvDepartureTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="08:30 AM"
            android:fontFamily="@font/roboto_bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTopBadge"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/green"
            android:id="@+id/tvPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹ 350"
            android:fontFamily="@font/roboto_bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#5b5b5b"
            android:id="@+id/tvArrivalTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="09:45 AM"
            android:fontFamily="@font/roboto"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvPrice"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/grey"
            android:id="@+id/tvSeatsInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="37 Seats Available"
            android:fontFamily="@font/roboto"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvDepartureTime"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#f39101"
            android:id="@+id/tvShuttleType"
            android:background="@drawable/rounded_border_background"
            android:paddingLeft="8dp"
            android:paddingTop="2dp"
            android:paddingRight="8dp"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AC Shuttle"
            android:backgroundTint="#fff8e1"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvArrivalTime"/>
        <TextView
            android:textSize="11sp"
            android:textColor="#4a4a4a"
            android:id="@+id/tvTripMeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="6 min walk • 1h 45m • Route 007"
            android:fontFamily="@font/roboto"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvSeatsInfo"/>
        <View
            android:id="@+id/divider"
            android:background="#f0f0f0"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/tvTripMeta"/>
        <ImageView
            android:id="@+id/ivRoutePath"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="12dp"
            android:src="@drawable/right_arrow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider"
            app:tint="@color/quantum_indigo"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/grey"
            android:ellipsize="end"
            android:id="@+id/tvRoutePath"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Park Street -&gt; Salt Lake -&gt; Airport"
            android:maxLines="1"
            android:fontFamily="@font/roboto"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/ivRoutePath"
            app:layout_constraintEnd_toStartOf="@+id/btnSelect"
            app:layout_constraintStart_toEndOf="@+id/ivRoutePath"
            app:layout_constraintTop_toTopOf="@+id/ivRoutePath"/>
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="12sp"
            android:textColor="@color/white"
            android:id="@+id/btnSelect"
            android:background="@drawable/button_background"
            android:layout_width="80dp"
            android:layout_height="36dp"
            android:text="Select"
            android:textAllCaps="false"
            android:fontFamily="@font/roboto_bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ivRoutePath"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
