<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    app:cardBackgroundColor="@color/black"
    app:cardCornerRadius="28dp"
    app:cardElevation="12dp"
    app:strokeColor="@color/black_text_01"
    app:strokeWidth="1.5dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/grey"
            android:id="@+id/tvBidTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New Offer Received"
            android:textAllCaps="true"
            android:fontFamily="@font/roboto_bold"
            android:letterSpacing="0.1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/ivDriverImg"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/avatar_1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvBidTitle"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/llDriverInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            app:layout_constraintEnd_toStartOf="@+id/tvBidAmount"
            app:layout_constraintStart_toEndOf="@+id/ivDriverImg"
            app:layout_constraintTop_toTopOf="@+id/ivDriverImg">
            <TextView
                android:textSize="19sp"
                android:textColor="@color/white"
                android:id="@+id/tvDriverName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rahul Kumar"
                android:fontFamily="@font/roboto_bold"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp">
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_star"
                    app:tint="#ffc107"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#ffc107"
                    android:id="@+id/tvDriverRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.9"
                    android:fontFamily="@font/roboto_bold"
                    android:layout_marginStart="4dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/grey"
                    android:id="@+id/tvTripsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(1250 trips)"
                    android:fontFamily="@font/roboto"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/grey"
                android:id="@+id/tvVehicleInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Honda City • 2.5 km"
                android:fontFamily="@font/roboto"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#4caf50"
                android:id="@+id/tvArrivalTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Arriving in 5 mins"
                android:fontFamily="@font/roboto_bold"/>
        </LinearLayout>
        <TextView
            android:textSize="32sp"
            android:textColor="@color/white"
            android:id="@+id/tvBidAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹280"
            android:fontFamily="@font/roboto_bold"
            app:layout_constraintBottom_toBottomOf="@+id/ivDriverImg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ivDriverImg"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:weightSum="2"
            app:layout_constraintTop_toBottomOf="@+id/ivDriverImg">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/red1"
                android:gravity="center"
                android:id="@+id/btnDeclineBid"
                android:background="@drawable/button_background01"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="Decline"
                android:layout_weight="0.8"
                android:fontFamily="@font/roboto_bold"
                android:layout_marginEnd="10dp"
                android:backgroundTint="#2c2c2e"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/btnAcceptBid"
                android:background="@drawable/button_background01"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="Accept Offer"
                android:layout_weight="1.2"
                android:fontFamily="@font/roboto_bold"
                android:layout_marginStart="10dp"
                android:backgroundTint="@color/white"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
