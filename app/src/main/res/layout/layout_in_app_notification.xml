<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/cvNotification"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="12dp"
    android:layout_marginRight="12dp"
    android:layout_marginBottom="16dp"
    android:layout_marginHorizontal="12dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="25dp"
    app:cardElevation="18dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/bg_notif_banner"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:background="@drawable/bg_status_badge"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:backgroundTint="@color/white">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/ivNotifIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/cab_bg1"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/white"
                android:id="@+id/tvNotifTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ride Accepted"
                android:fontFamily="@font/roboto_bold"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#b3b3b3"
                android:id="@+id/tvNotifMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your driver is arriving soon"
                android:fontFamily="@font/roboto"/>
        </LinearLayout>
        <View
            android:background="#33ffffff"
            android:layout_width="1dp"
            android:layout_height="30dp"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginHorizontal="12dp"/>
        <ImageView
            android:id="@+id/ivCloseNotif"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@drawable/close"
            android:layout_marginEnd="4dp"
            app:tint="@color/white"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
