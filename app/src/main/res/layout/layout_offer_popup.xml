<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="12dp"
    app:strokeWidth="0dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/headerContainer"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            app:layout_constraintTop_toTopOf="parent">
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivOfferImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/refernearn"
                android:scaleType="centerInside"
                android:adjustViewBounds="true"
                app:shapeAppearanceOverlay="@style/RoundedTopCorners"/>
        </FrameLayout>
        <ImageView
            android:id="@+id/ivClose"
            android:background="@drawable/round_corner"
            android:padding="8dp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_margin="16dp"
            android:src="@drawable/ic_baseline_close_24"
            android:backgroundTint="#80000000"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white"/>
        <TextView
            android:textSize="22sp"
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/tvOfferTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="24dp"
            android:text="Refer More - Earn More"
            android:fontFamily="@font/roboto_bold"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/headerContainer"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/grey"
            android:gravity="center"
            android:id="@+id/tvOfferDesc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="24dp"
            android:text="Refer a friend and get ₹50 when your friend signs up or completes their first ride."
            android:lineSpacingExtra="4dp"
            android:fontFamily="@font/roboto"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvOfferTitle"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/llPromoCode"
            android:background="@drawable/bg_referral_earnings"
            android:paddingLeft="20dp"
            android:paddingTop="14dp"
            android:paddingRight="20dp"
            android:paddingBottom="14dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="40dp"
            android:layout_marginHorizontal="40dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvOfferDesc">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/black"
                android:id="@+id/tvPromoLabel"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PROMO CODE: "
                android:fontFamily="@font/roboto_bold"
                android:letterSpacing="0.05"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/black"
                android:id="@+id/tvPromoCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USE YOUR REFERRAL CODE"
                android:fontFamily="@font/roboto_bold"
                android:letterSpacing="0.05"/>
            <ImageView
                android:id="@+id/ivCopyCode"
                android:visibility="gone"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/copy"
                android:layout_marginStart="8dp"
                app:tint="@color/black"/>
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="16sp"
            android:textColor="@color/white"
            android:id="@+id/btnClaim"
            android:background="@drawable/button_bg"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="32dp"
            android:text="INVITE NOW"
            android:textAllCaps="false"
            android:fontFamily="@font/roboto_bold"
            android:layout_marginHorizontal="32dp"
            app:layout_constraintTop_toBottomOf="@+id/llPromoCode"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/grey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="T&amp;C Apply"
            android:fontFamily="@font/roboto"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnClaim"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
