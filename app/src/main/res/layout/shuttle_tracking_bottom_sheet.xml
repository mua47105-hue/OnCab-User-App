<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomSheetContainer"
    android:background="@drawable/bottom_sheet_top_rounded"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:behavior_hideable="false"
    app:behavior_peekHeight="240dp"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <View
        android:id="@+id/grabber"
        android:background="@drawable/bg_grabber"
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_marginTop="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <RelativeLayout
        android:id="@+id/headerLayout"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingHorizontal="18dp"
        app:layout_constraintTop_toBottomOf="@+id/grabber">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:layout_toStartOf="@+id/llDriverAction">
            <TextView
                android:textSize="17sp"
                android:textColor="#0f172a"
                android:ellipsize="end"
                android:id="@+id/tvRoute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="@font/roboto_bold"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp">
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/white"
                    android:id="@+id/tvBusPlateTag"
                    android:background="@drawable/bg_black_rounded_small"
                    android:paddingLeft="6dp"
                    android:paddingTop="2dp"
                    android:paddingRight="6dp"
                    android:paddingBottom="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_bold"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#64748b"
                    android:ellipsize="end"
                    android:id="@+id/tvDriverInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:fontFamily="@font/roboto_medium"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/llDriverAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true">
            <ImageView
                android:id="@+id/ivCallDriver"
                android:background="@drawable/circle1"
                android:padding="9dp"
                android:visibility="gone"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_baseline_call_24"
                android:backgroundTint="#f1f5f9"
                app:tint="#059669"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/orange"
                android:id="@+id/tvViewAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Bookings"
                android:fontFamily="@font/roboto_bold"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/statsLayout"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@+id/headerLayout">
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            app:cardBackgroundColor="#f8fafc"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="#e2e8f0"
            app:strokeWidth="1dp">
            <LinearLayout
                android:orientation="vertical"
                android:padding="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="10sp"
                    android:textColor="#64748b"
                    android:id="@+id/tvDistanceLeftLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Distance / ETA"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="#059669"
                    android:id="@+id/tvDistanceLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="2.4 km • 7 min"
                    android:singleLine="true"
                    android:fontFamily="@font/roboto_bold"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            app:cardBackgroundColor="#f8fafc"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="#e2e8f0"
            app:strokeWidth="1dp">
            <LinearLayout
                android:orientation="vertical"
                android:padding="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="10sp"
                    android:textColor="#64748b"
                    android:id="@+id/tvStopsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your Pickup Stop"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="#0f172a"
                    android:ellipsize="end"
                    android:id="@+id/tvStops"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Park Street"
                    android:singleLine="true"
                    android:fontFamily="@font/roboto_bold"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.85"
            android:layout_marginStart="6dp"
            app:cardBackgroundColor="#f8fafc"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="#e2e8f0"
            app:strokeWidth="1dp">
            <LinearLayout
                android:orientation="vertical"
                android:padding="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="10sp"
                    android:textColor="#64748b"
                    android:id="@+id/tvPassengersLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Seat(s)"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="#0f172a"
                    android:ellipsize="end"
                    android:id="@+id/tvPassengers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="1 Seat"
                    android:singleLine="true"
                    android:fontFamily="@font/roboto_bold"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
    <View
        android:id="@+id/divider"
        android:background="#f1f5f9"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@+id/statsLayout"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/llStoppagesHeader"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="18dp"
        app:layout_constraintTop_toBottomOf="@+id/divider">
        <TextView
            android:textSize="14sp"
            android:textColor="#1e293b"
            android:id="@+id/tvStoppagesTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="All Route Stoppages"
            android:layout_weight="1"
            android:fontFamily="@font/roboto_bold"/>
        <TextView
            android:textSize="11sp"
            android:textColor="#94a3b8"
            android:id="@+id/tvStoppagesHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to focus on map"
            android:fontFamily="@font/roboto"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvStoppagesTimeline"
        android:paddingBottom="12dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:nestedScrollingEnabled="true"
        app:layout_constrainedHeight="true"
        app:layout_constraintHeight_max="280dp"
        app:layout_constraintTop_toBottomOf="@+id/llStoppagesHeader"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/bottomActionsLayout"
        android:paddingLeft="18dp"
        android:paddingTop="6dp"
        android:paddingRight="18dp"
        android:paddingBottom="18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="18dp"
        app:layout_constraintTop_toBottomOf="@+id/rvStoppagesTimeline">
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="15sp"
            android:textColor="@color/white"
            android:id="@+id/btnArrivalInfo"
            android:background="@drawable/button_background"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="View Ticket / Boarding Pass"
            android:textAllCaps="false"
            android:fontFamily="@font/roboto_bold"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
