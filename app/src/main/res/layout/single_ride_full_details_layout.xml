<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout14"
        android:background="?attr/colorSurface"
        android:paddingLeft="16dp"
        android:paddingTop="6dp"
        android:paddingRight="16dp"
        android:paddingBottom="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/backBtn"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/new_gray"/>
        <TextView
            android:textSize="18sp"
            android:textColor="?attr/colorOnSurface"
            android:id="@+id/orderDateTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wed, Feb 21, 10:25 AM"
            android:fontFamily="@font/roboto_medium"
            android:layout_marginStart="24dp"
            app:layout_constraintStart_toEndOf="@+id/backBtn"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/grey"
            android:id="@+id/orderID"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CRN 10000020"
            android:fontFamily="@font/roboto_medium"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/orderDateTime"
            app:layout_constraintTop_toBottomOf="@+id/orderDateTime"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.core.widget.NestedScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollIndicators="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/constraintLayout14">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/constraintLayout14">
            <ImageView
                android:id="@+id/imageView51"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:src="@drawable/map_image"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:id="@+id/textView46"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:text="You rated"
                android:layout_marginHorizontal="16dp"
                android:paddingVertical="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imageView51"
                style="@style/TextTitle18"/>
            <androidx.appcompat.widget.AppCompatRatingBar
                android:id="@+id/rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:rating="4"
                android:progressTint="#0b0800"
                app:layout_constraintStart_toStartOf="@+id/textView46"
                app:layout_constraintTop_toBottomOf="@+id/textView46"
                style="?android:attr/ratingBarStyleIndicator"/>
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/driverProfilePic"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/profile"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/rating"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/textView46"/>
            <ImageView
                android:id="@+id/carImage"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="16dp"
                android:src="@drawable/ic_car_type"
                app:layout_constraintStart_toStartOf="@+id/rating"
                app:layout_constraintTop_toBottomOf="@+id/rating"/>
            <TextView
                android:textSize="16sp"
                android:id="@+id/carName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Prime Sedan, white Zest"
                android:fontFamily="@font/roboto"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/carImage"
                app:layout_constraintEnd_toEndOf="@+id/driverProfilePic"
                app:layout_constraintStart_toEndOf="@+id/carImage"
                app:layout_constraintTop_toTopOf="@+id/carImage"
                style="@style/TextTitle18"/>
            <View
                android:id="@+id/v1"
                android:background="@color/lightGray"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/carImage"
                app:layout_constraintTop_toBottomOf="@+id/carImage"/>
            <ImageView
                android:id="@+id/priceImage"
                android:layout_width="40dp"
                android:layout_height="30dp"
                android:layout_marginTop="16dp"
                android:src="@drawable/receipt"
                app:layout_constraintStart_toStartOf="@+id/v1"
                app:layout_constraintTop_toBottomOf="@+id/v1"/>
            <TextView
                android:textSize="18sp"
                android:id="@+id/rentalPrice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="₹200"
                android:fontFamily="@font/roboto"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/priceImage"
                app:layout_constraintEnd_toEndOf="@+id/driverProfilePic"
                app:layout_constraintStart_toEndOf="@+id/priceImage"
                app:layout_constraintTop_toTopOf="@+id/priceImage"
                style="@style/TextTitle18"/>
            <View
                android:id="@+id/v2"
                android:background="@color/lightGray"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/priceImage"
                app:layout_constraintTop_toBottomOf="@+id/priceImage"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/grey"
                android:id="@+id/sTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="10:00 AM"
                android:fontFamily="@font/roboto"
                app:layout_constraintStart_toStartOf="@+id/v2"
                app:layout_constraintTop_toBottomOf="@+id/v2"/>
            <ImageView
                android:id="@+id/imageView52"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/circle1"
                android:layout_marginStart="24dp"
                app:layout_constraintBottom_toBottomOf="@+id/sTime"
                app:layout_constraintStart_toEndOf="@+id/sTime"
                app:layout_constraintTop_toTopOf="@+id/sTime"
                app:tint="@color/green"/>
            <TextView
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurface"
                android:ellipsize="end"
                android:id="@+id/sourceLocation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Hittok Pvt Ltd, New Garia, Kolkata, 700094"
                android:maxLines="2"
                android:fontFamily="@font/roboto"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/imageView52"
                app:layout_constraintTop_toTopOf="@+id/sTime"/>
            <View
                android:id="@+id/view14"
                android:background="@color/grey"
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_marginBottom="-16dp"
                app:layout_constraintBottom_toBottomOf="@+id/sourceLocation"
                app:layout_constraintEnd_toEndOf="@+id/imageView52"
                app:layout_constraintStart_toStartOf="@+id/imageView52"
                app:layout_constraintTop_toBottomOf="@+id/imageView52"/>
            <ImageView
                android:id="@+id/imageView53"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/circle1"
                app:layout_constraintEnd_toEndOf="@+id/view14"
                app:layout_constraintStart_toStartOf="@+id/view14"
                app:layout_constraintTop_toBottomOf="@+id/view14"
                app:tint="@color/red"/>
            <TextView
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurface"
                android:ellipsize="end"
                android:id="@+id/destinationLocation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Howrah Railway Station, Howrah, Kolkata,West Bengal, India, Univers 700094"
                android:maxLines="2"
                android:fontFamily="@font/roboto"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/imageView52"
                app:layout_constraintTop_toBottomOf="@+id/view14"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/grey"
                android:id="@+id/dTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:10 PM"
                android:fontFamily="@font/roboto"
                app:layout_constraintStart_toStartOf="@+id/sTime"
                app:layout_constraintTop_toBottomOf="@+id/view14"/>
            <View
                android:id="@+id/v3"
                android:background="@color/grey"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/destinationLocation"/>
            <TextView
                android:id="@+id/billDetailsText"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:text="Bill Details"
                android:layout_marginHorizontal="16dp"
                android:paddingVertical="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/v3"
                style="@style/TextTitle18"/>
            <TextView
                android:textColor="@color/textColorDarkGray"
                android:id="@+id/textView47"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Trip"
                app:layout_constraintStart_toStartOf="@+id/billDetailsText"
                app:layout_constraintTop_toBottomOf="@+id/billDetailsText"
                style="@style/TextTitle14"/>
            <TextView
                android:textColor="@color/textColorDarkGray"
                android:id="@+id/tripPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹180"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/textView47"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/textView47"/>
            <TextView
                android:textColor="@color/textColorDarkGray"
                android:id="@+id/wFeeT"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12sp"
                android:text="Waiting Fees"
                app:layout_constraintStart_toStartOf="@+id/textView47"
                app:layout_constraintTop_toBottomOf="@+id/textView47"
                style="@style/TextTitle14"/>
            <TextView
                android:textColor="@color/textColorDarkGray"
                android:id="@+id/wFeePrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹19.50"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/wFeeT"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/wFeeT"/>
            <View
                android:id="@+id/v4"
                android:background="@color/grey"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/wFeeT"
                app:layout_constraintTop_toBottomOf="@+id/wFeeT"/>
            <TextView
                android:textColor="@color/textColorDarkGray"
                android:id="@+id/roundOffText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12sp"
                android:text="Rounded Off"
                app:layout_constraintStart_toStartOf="@+id/v4"
                app:layout_constraintTop_toBottomOf="@+id/v4"
                style="@style/TextTitle14"/>
            <TextView
                android:textColor="@color/textColorDarkGray"
                android:id="@+id/roundOffPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0.50"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/roundOffText"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/roundOffText"/>
            <View
                android:id="@+id/v5"
                android:background="@color/grey"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/roundOffText"
                app:layout_constraintTop_toBottomOf="@+id/roundOffText"/>
            <TextView
                android:id="@+id/totalPayableText"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:text="Total Payable"
                android:layout_marginHorizontal="16dp"
                android:paddingVertical="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/v5"
                style="@style/TextTitle18"/>
            <TextView
                android:textSize="16sp"
                android:textColor="?attr/colorOnSurface"
                android:id="@+id/totalPayableAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹200"
                android:fontFamily="@font/roboto_medium"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/totalPayableText"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/totalPayableText"/>
            <View
                android:id="@+id/v6"
                android:background="@color/grey"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/totalPayableText"
                app:layout_constraintTop_toBottomOf="@+id/totalPayableText"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:weightSum="3"
                app:layout_constraintStart_toStartOf="@+id/v6"
                app:layout_constraintTop_toBottomOf="@+id/v6">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/couponApplied"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/coupon_02"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="USE COUPON"
                        android:fontFamily="@font/roboto"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/mainInvoice"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/invoice"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="MAIL INVOICE"
                        android:fontFamily="@font/roboto"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/support"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/support_02"
                        app:tint="?attr/colorOnSurface"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="SUPPORT"
                        android:fontFamily="@font/roboto"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
