<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="0dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="12dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingVertical="12dp">
        <TextView
            android:id="@+id/textView39"
            android:background="@drawable/button_background"
            android:layout_width="10dp"
            android:layout_height="30dp"
            android:layout_marginTop="6dp"
            android:layout_marginStart="-6dp"
            android:backgroundTint="@color/green"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/primaryTextColor"
            android:id="@+id/offerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="50% OFF up to 100"
            android:fontFamily="@font/roboto"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/textView39"
            app:layout_constraintStart_toEndOf="@+id/textView39"
            app:layout_constraintTop_toTopOf="@+id/textView39"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/grey"
            android:id="@+id/couponCode"
            android:background="@drawable/border_4dp_background"
            android:paddingLeft="10dp"
            android:paddingTop="6dp"
            android:paddingRight="10dp"
            android:paddingBottom="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="ONCABNEW"
            android:fontFamily="@font/roboto"
            android:letterSpacing="0.1"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            app:layout_constraintStart_toStartOf="@+id/offerTitle"
            app:layout_constraintTop_toBottomOf="@+id/offerTitle"/>
        <TextView
            android:id="@+id/textView41"
            android:background="@drawable/circle"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="-16dp"
            android:backgroundTint="@color/veryLightGray"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/couponCode"/>
        <TextView
            android:id="@+id/textView40"
            android:background="@drawable/circle"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="-16dp"
            android:backgroundTint="@color/veryLightGray"
            app:layout_constraintBottom_toBottomOf="@+id/textView41"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/textView41"/>
        <View
            android:id="@+id/view12"
            android:background="@drawable/dashed_line"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/textView40"
            app:layout_constraintEnd_toStartOf="@+id/textView40"
            app:layout_constraintStart_toEndOf="@+id/textView41"
            app:layout_constraintTop_toTopOf="@+id/textView41"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/red"
            android:id="@+id/applyBtn"
            android:background="@drawable/apply_button_background"
            android:paddingLeft="12dp"
            android:paddingTop="6dp"
            android:paddingRight="12dp"
            android:paddingBottom="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="APPLY"
            android:fontFamily="@font/roboto"
            android:layout_marginEnd="16dp"
            android:letterSpacing="0.1"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView40"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/green"
            android:ellipsize="end"
            android:id="@+id/offerDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Save ₹100 with this order"
            android:maxLines="2"
            android:fontFamily="@font/roboto"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/applyBtn"
            app:layout_constraintEnd_toStartOf="@+id/applyBtn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/applyBtn"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
