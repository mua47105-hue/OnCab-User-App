<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/flBusIconContainer"
        android:layout_width="48dp"
        android:layout_height="48dp">
        <View
            android:id="@+id/vRadarHalo"
            android:background="@drawable/circle_pulse"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:backgroundTint="#fef3c7"/>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/flBusBadgeCore"
            android:background="@drawable/circle1"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:elevation="6dp"
            android:backgroundTint="#d97706">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/ivBusIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_shuttle_bus"
                app:tint="@color/white"/>
        </FrameLayout>
    </FrameLayout>
    <TextView
        android:textSize="9sp"
        android:textColor="@color/white"
        android:id="@+id/tvBusPlateTag"
        android:background="@drawable/bg_black_rounded_small"
        android:paddingLeft="7dp"
        android:paddingTop="2dp"
        android:paddingRight="7dp"
        android:paddingBottom="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="SHUTTLE BUS"
        android:singleLine="true"
        android:fontFamily="@font/roboto_bold"
        android:elevation="6dp"
        android:paddingHorizontal="7dp"
        android:paddingVertical="2dp"/>
</LinearLayout>
