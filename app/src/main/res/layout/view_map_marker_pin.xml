<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/llMarkerPill"
        android:background="@drawable/bg_map_marker_pill"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="10dp">
        <TextView
            android:textSize="11sp"
            android:textColor="#059669"
            android:gravity="center"
            android:id="@+id/tvMarkerSeq"
            android:background="@drawable/circle1"
            android:visibility="gone"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:text="1"
            android:fontFamily="@font/roboto_bold"
            android:layout_marginEnd="6dp"/>
        <ImageView
            android:id="@+id/ivMarkerIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_shuttle_bus"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp">
            <TextView
                android:textSize="11sp"
                android:textColor="@color/white"
                android:id="@+id/tvMarkerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pickup"
                android:singleLine="true"
                android:fontFamily="@font/roboto_bold"/>
            <TextView
                android:textSize="9sp"
                android:textColor="#f3f4f6"
                android:ellipsize="end"
                android:id="@+id/tvMarkerSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="130dp"
                android:text="South City Mall"
                android:singleLine="true"
                android:fontFamily="@font/roboto_medium"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/ivMarkerArrow"
        android:layout_width="14dp"
        android:layout_height="8dp"
        android:layout_marginTop="-1dp"
        android:src="@drawable/ic_marker_arrow"/>
</LinearLayout>
