<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_new_home_map">
    <fragment
        android:label="Destination"
        android:name="com.oncab.user.ui.bookinghistory.BookingHistoryFragment"
        android:id="@+id/navigation_booking_history">
        <action
            android:id="@+id/navigation_booking_history_to_home"
            app:destination="@+id/navigation_new_home_map"
            app:enterAnim="@anim/slide_in_left"
            app:exitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/navigation_booking_history_to_order_details"
            app:destination="@+id/navigation_order_details"/>
    </fragment>
    <fragment
        android:label="SingleOrder"
        android:name="com.oncab.user.ui.singlebookingdetails.SingleBookingDetailsFragment"
        android:id="@+id/navigation_order_details"/>
    <fragment
        android:label="Destination"
        android:name="com.oncab.user.ui.DestinationFragment"
        android:id="@+id/navigation_destination">
        <action
            android:id="@+id/navigation_destination_to_home"
            app:destination="@+id/navigation_new_home_map"/>
        <action
            android:id="@+id/navigation_destination_to_carlist"
            app:destination="@+id/navigation_carlist"
            app:enterAnim="@anim/slide_up"
            app:exitAnim="@anim/slide_down"/>
        <action
            android:id="@+id/navigation_destination_to_second_destination"
            app:destination="@+id/navigation_second_destination"
            app:enterAnim="@anim/slide_up"
            app:exitAnim="@anim/slide_down"/>
        <action
            android:id="@+id/navigation_destination_to_confirm_destination"
            app:destination="@+id/navigation_confirm_destination"/>
    </fragment>
    <fragment
        android:label="Home"
        android:name="com.oncab.user.ui.NewHomeMapsFragment"
        android:id="@+id/navigation_new_home_map">
        <action
            android:id="@+id/navigation_home_to_destination"
            app:destination="@+id/navigation_destination"/>
        <action
            android:id="@+id/navigation_home_to_confirm_destination"
            app:destination="@+id/navigation_confirm_destination"/>
        <action
            android:id="@+id/navigation_home_to_booking_details"
            app:destination="@+id/navigation_booking_details"/>
        <action
            android:id="@+id/navigation_home_to_shuttle_search"
            app:destination="@+id/navigation_shuttle_search"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:label="Shuttle Search"
        android:name="com.oncab.user.ui.shuttle.ShuttleSearchFragment"
        android:id="@+id/navigation_shuttle_search">
        <action
            android:id="@+id/action_shuttle_search_to_home"
            app:destination="@+id/navigation_new_home_map"/>
        <action
            android:id="@+id/action_shuttle_search_to_routes"
            app:destination="@+id/navigation_shuttle_routes"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_shuttle_search_to_trips"
            app:destination="@+id/navigation_shuttle_trips"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:label="Select Route"
        android:name="com.oncab.user.ui.shuttle.ShuttleRoutesFragment"
        android:id="@+id/navigation_shuttle_routes">
        <action
            android:id="@+id/action_shuttle_routes_to_seats"
            app:destination="@+id/navigation_shuttle_seats"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_shuttle_routes_to_trips"
            app:destination="@+id/navigation_shuttle_trips"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:label="Available Trips"
        android:name="com.oncab.user.ui.shuttle.ShuttleTripsFragment"
        android:id="@+id/navigation_shuttle_trips">
        <action
            android:id="@+id/action_shuttle_trips_to_seats"
            app:destination="@+id/navigation_shuttle_seats"/>
    </fragment>
    <fragment
        android:label="Select Seats"
        android:name="com.oncab.user.ui.shuttle.ShuttleSeatsFragment"
        android:id="@+id/navigation_shuttle_seats">
        <action
            android:id="@+id/action_shuttle_seats_to_payment"
            app:destination="@+id/navigation_shuttle_payment"/>
        <action
            android:id="@+id/action_shuttle_seats_to_ticket"
            app:destination="@+id/navigation_shuttle_ticket"
            app:popUpTo="@+id/navigation_new_home_map"/>
    </fragment>
    <fragment
        android:label="Payment"
        android:name="com.oncab.user.ui.shuttle.ShuttlePaymentFragment"
        android:id="@+id/navigation_shuttle_payment">
        <action
            android:id="@+id/action_shuttle_payment_to_ticket"
            app:destination="@+id/navigation_shuttle_ticket"
            app:popUpTo="@+id/navigation_new_home_map"/>
    </fragment>
    <fragment
        android:label="Ticket"
        android:name="com.oncab.user.ui.shuttle.ShuttleTicketFragment"
        android:id="@+id/navigation_shuttle_ticket">
        <action
            android:id="@+id/action_shuttle_ticket_to_tracking"
            app:destination="@+id/navigation_shuttle_tracking"/>
        <action
            android:id="@+id/action_shuttle_ticket_to_boarding"
            app:destination="@+id/navigation_shuttle_boarding"/>
        <action
            android:id="@+id/action_shuttle_ticket_to_home"
            app:destination="@+id/navigation_new_home_map"
            app:popUpTo="@+id/navigation_new_home_map"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/action_shuttle_ticket_to_bookings"
            app:destination="@+id/navigation_shuttle_bookings"/>
    </fragment>
    <fragment
        android:label="Track Shuttle"
        android:name="com.oncab.user.ui.shuttle.ShuttleTrackingFragment"
        android:id="@+id/navigation_shuttle_tracking">
        <action
            android:id="@+id/action_shuttle_tracking_to_ticket"
            app:destination="@+id/navigation_shuttle_ticket"/>
        <action
            android:id="@+id/action_shuttle_tracking_to_bookings"
            app:destination="@+id/navigation_shuttle_bookings"/>
        <action
            android:id="@+id/action_shuttle_tracking_to_boarding"
            app:destination="@+id/navigation_shuttle_boarding"/>
    </fragment>
    <fragment
        android:label="Boarding"
        android:name="com.oncab.user.ui.shuttle.ShuttleBoardingFragment"
        android:id="@+id/navigation_shuttle_boarding">
        <action
            android:id="@+id/action_shuttle_boarding_to_tracking"
            app:destination="@+id/navigation_shuttle_tracking"
            app:popUpTo="@+id/navigation_shuttle_tracking"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/action_shuttle_boarding_to_bookings"
            app:destination="@+id/navigation_shuttle_bookings"/>
        <action
            android:id="@+id/action_shuttle_boarding_to_summary"
            app:destination="@+id/navigation_shuttle_summary"/>
    </fragment>
    <fragment
        android:label="Trip Summary"
        android:name="com.oncab.user.ui.shuttle.ShuttleSummaryFragment"
        android:id="@+id/navigation_shuttle_summary">
        <action
            android:id="@+id/action_shuttle_summary_to_home"
            app:destination="@+id/navigation_new_home_map"
            app:popUpTo="@+id/navigation_new_home_map"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/action_shuttle_summary_to_bookings"
            app:destination="@+id/navigation_shuttle_bookings"/>
    </fragment>
    <fragment
        android:label="My Shuttle Bookings"
        android:name="com.oncab.user.ui.shuttle.ShuttleBookingsFragment"
        android:id="@+id/navigation_shuttle_bookings">
        <action
            android:id="@+id/action_shuttle_bookings_to_ticket"
            app:destination="@+id/navigation_shuttle_ticket"/>
        <action
            android:id="@+id/action_shuttle_bookings_to_tracking"
            app:destination="@+id/navigation_shuttle_tracking"/>
    </fragment>
    <fragment
        android:label="SecondDestination"
        android:name="com.oncab.user.ui.SecondDestinationFragment"
        android:id="@+id/navigation_second_destination">
        <action
            android:id="@+id/navigation_second_destination_to_confirm_destination"
            app:destination="@+id/navigation_confirm_destination"/>
        <action
            android:id="@+id/navigation_second_destination_to_carlist"
            app:destination="@+id/navigation_carlist"/>
        <action
            android:id="@+id/navigation_second_destination_to_home"
            app:destination="@+id/navigation_new_home_map"/>
    </fragment>
    <fragment
        android:label="ConfirmDestination"
        android:name="com.oncab.user.ui.ConfirmLocationFragment"
        android:id="@+id/navigation_confirm_destination">
        <action
            android:id="@+id/navigation_confirm_destination_to_payment_mode"
            app:destination="@+id/navigation_payment_mode"/>
        <action
            android:id="@+id/navigation_confirm_destination_to_home"
            app:destination="@+id/navigation_new_home_map"/>
        <action
            android:id="@+id/navigation_confirm_destination_to_coupon"
            app:destination="@+id/navigation_coupon_list"/>
        <action
            android:id="@+id/navigation_confirm_destination_to_carlist"
            app:destination="@+id/navigation_carlist"/>
        <action
            android:id="@+id/navigation_confirm_destination_to_booking"
            app:destination="@+id/navigation_booking"/>
        <action
            android:id="@+id/navigation_confirm_to_destination"
            app:destination="@+id/navigation_destination"/>
    </fragment>
    <fragment
        android:label="CarList"
        android:name="com.oncab.user.ui.carlist.CarListFragment"
        android:id="@+id/navigation_carlist">
        <action
            android:id="@+id/navigation_cartlist_to_home"
            app:destination="@+id/navigation_new_home_map"
            app:enterAnim="@anim/slide_up"
            app:exitAnim="@anim/slide_down"/>
        <action
            android:id="@+id/navigation_cartlist_to_confirm_destination"
            app:destination="@+id/navigation_confirm_destination"
            app:enterAnim="@anim/slide_up"
            app:exitAnim="@anim/slide_down"/>
    </fragment>
    <fragment
        android:label="CouponList"
        android:name="com.oncab.user.ui.coupon.CouponListFragment"
        android:id="@+id/navigation_coupon_list">
        <action
            android:id="@+id/navigation_coupon_list_to_home"
            app:destination="@+id/navigation_new_home_map"
            app:enterAnim="@anim/slide_up"
            app:exitAnim="@anim/slide_down"/>
        <action
            android:id="@+id/navigation_coupon_list_to_confirm_destination"
            app:destination="@+id/navigation_confirm_destination"
            app:enterAnim="@anim/slide_up"
            app:exitAnim="@anim/slide_down"/>
    </fragment>
    <fragment
        android:label="Booking"
        android:name="com.oncab.user.ui.booking.BookingFragment"
        android:id="@+id/navigation_booking">
        <action
            android:id="@+id/navigation_booking_to_home"
            app:destination="@+id/navigation_new_home_map"/>
        <action
            android:id="@+id/navigation_booking_to_booking_details"
            app:destination="@+id/navigation_booking_details"/>
    </fragment>
    <fragment
        android:label="BookingDetails"
        android:name="com.oncab.user.ui.bookingdetails.BookingDetailsFragment"
        android:id="@+id/navigation_booking_details">
        <action
            android:id="@+id/navigation_booking_details_to_contact_driver"
            app:destination="@+id/navigation_chaList"
            app:enterAnim="@anim/slide_up"
            app:exitAnim="@anim/slide_down"/>
        <action
            android:id="@+id/navigation_booking_details_to_home"
            app:destination="@+id/navigation_new_home_map"
            app:enterAnim="@anim/slide_up"
            app:exitAnim="@anim/slide_down"/>
        <action
            android:id="@+id/navigation_booking_details_to_booking"
            app:destination="@+id/navigation_booking"/>
    </fragment>
    <fragment
        android:label="Account"
        android:name="com.oncab.user.ui.account.AccountFragment"
        android:id="@+id/navigation_account">
        <action
            android:id="@+id/navigation_account_to_booking_history"
            app:destination="@+id/navigation_booking_history"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:label="Payment Mode"
        android:name="com.oncab.user.ui.paymentmode.PaymentModeFragment"
        android:id="@+id/navigation_payment_mode">
        <action
            android:id="@+id/navigation_payment_mode_to_confirm_booking"
            app:destination="@+id/navigation_confirm_destination"
            app:enterAnim="@anim/slide_up"
            app:exitAnim="@anim/slide_down"/>
    </fragment>
    <fragment
        android:label="ContactDriver"
        android:name="com.oncab.user.ui.contactdriver.ContactDriverFragment"
        android:id="@+id/navigation_chaList"/>
    <fragment
        android:label="Connect"
        android:name="com.oncab.user.ui.ConnectFragment"
        android:id="@+id/navigation_inbox">
        <action
            android:id="@+id/action_navigation_inbox_to_community_chat"
            app:destination="@+id/navigation_community_chat"
            app:enterAnim="@anim/slide_up"
            app:exitAnim="@anim/slide_down"/>
        <action
            android:id="@+id/action_navigation_inbox_to_emergency_sos"
            app:destination="@+id/navigation_emergency_sos"
            app:enterAnim="@anim/slide_up"
            app:exitAnim="@anim/slide_down"/>
    </fragment>
    <fragment
        android:label="Community Chat"
        android:name="com.oncab.user.ui.CommunityChatFragment"
        android:id="@+id/navigation_community_chat"/>
    <fragment
        android:label="Emergency SOS"
        android:name="com.oncab.user.ui.EmergencySOSFragment"
        android:id="@+id/navigation_emergency_sos"/>
    <fragment
        android:label="Emergency Contacts"
        android:name="com.oncab.user.ui.EmergencyContactFragment"
        android:id="@+id/navigation_emergency_contacts"/>
</navigation>
